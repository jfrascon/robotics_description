<?xml version="1.0"?>
<robot name="test_realsense_d435" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotics_description)/urdf/common/all_commons.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/sensors/cameras/realsense_d435_split_macro.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/sensors/cameras/generic_macros/set_props_plugin_camera_macro.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/sensors/cameras/generic_macros/set_props_plugin_camera_depth_macro.xacro"/>

  <xacro:property name="sim_cfg"
                  value="${xacro.load_yaml('$(find robotics_description)/config/sensors/cameras/example_realsense_d435_split_simulation.yaml')}"/>

  <xacro:set_props_plugin_camera prop_prefix="rs_color"
                                 sim_cfg="${sim_cfg['color']}"/>

  <xacro:set_props_plugin_camera_depth prop_prefix="rs_depth"
                                       sim_cfg="${sim_cfg['depth']}"/>

  <xacro:set_props_plugin_camera prop_prefix="rs_infra1"
                                 sim_cfg="${sim_cfg['infra1']}"/>

  <xacro:set_props_plugin_camera prop_prefix="rs_infra2"
                                 sim_cfg="${sim_cfg['infra2']}"/>

  <link name="base_link"/>

  <xacro:realsense_d435 name="cam"
                        parent_frame="base_link"
                        use_sensor_frames_and_joints="True"
                        sim_color_enabled="${rs_color_enabled}"
                        sim_color_use_gravity="${rs_color_use_gravity}"
                        sim_color_always_on="${rs_color_always_on}"
                        sim_color_visualize="${rs_color_visualize}"
                        sim_color_enable_metrics="${rs_color_enable_metrics}"
                        sim_color_save="${rs_color_save}"
                        sim_color_triggered="${rs_color_triggered}"
                        sim_color_visible_mask="${rs_color_visible_mask}"
                        sim_color_clip="${rs_color_clip}"
                        sim_color_update_rate="${rs_color_update_rate}"
                        sim_color_image="${rs_color_image}"
                        sim_color_lens_single_elements="${rs_color_lens_single_elements}"
                        sim_color_lens_custom_function="${rs_color_lens_custom_function}"
                        sim_color_lens_intrinsics="${rs_color_lens_intrinsics}"
                        sim_color_lens_xy_skew="${rs_color_lens_xy_skew}"
                        sim_color_lens_projection="${rs_color_lens_projection}"
                        sim_color_distortion_k_p="${rs_color_distortion_k_p}"
                        sim_color_distortion_center="${rs_color_distortion_center}"
                        sim_color_gaussian_noise="${rs_color_gaussian_noise}"
                        sim_depth_enabled="${rs_depth_enabled}"
                        sim_depth_use_gravity="${rs_depth_use_gravity}"
                        sim_depth_always_on="${rs_depth_always_on}"
                        sim_depth_visualize="${rs_depth_visualize}"
                        sim_depth_enable_metrics="${rs_depth_enable_metrics}"
                        sim_depth_save="${rs_depth_save}"
                        sim_depth_triggered="${rs_depth_triggered}"
                        sim_depth_visible_mask="${rs_depth_visible_mask}"
                        sim_depth_clip="${rs_depth_clip}"
                        sim_depth_depth_clip="${rs_depth_depth_clip}"
                        sim_depth_update_rate="${rs_depth_update_rate}"
                        sim_depth_image="${rs_depth_image}"
                        sim_depth_lens_single_elements="${rs_depth_lens_single_elements}"
                        sim_depth_lens_custom_function="${rs_depth_lens_custom_function}"
                        sim_depth_lens_intrinsics="${rs_depth_lens_intrinsics}"
                        sim_depth_lens_xy_skew="${rs_depth_lens_xy_skew}"
                        sim_depth_lens_projection="${rs_depth_lens_projection}"
                        sim_depth_distortion_k_p="${rs_depth_distortion_k_p}"
                        sim_depth_distortion_center="${rs_depth_distortion_center}"
                        sim_depth_gaussian_noise="${rs_depth_gaussian_noise}"
                        sim_infra1_enabled="${rs_infra1_enabled}"
                        sim_infra1_use_gravity="${rs_infra1_use_gravity}"
                        sim_infra1_always_on="${rs_infra1_always_on}"
                        sim_infra1_visualize="${rs_infra1_visualize}"
                        sim_infra1_enable_metrics="${rs_infra1_enable_metrics}"
                        sim_infra1_save="${rs_infra1_save}"
                        sim_infra1_triggered="${rs_infra1_triggered}"
                        sim_infra1_visible_mask="${rs_infra1_visible_mask}"
                        sim_infra1_clip="${rs_infra1_clip}"
                        sim_infra1_update_rate="${rs_infra1_update_rate}"
                        sim_infra1_image="${rs_infra1_image}"
                        sim_infra1_lens_single_elements="${rs_infra1_lens_single_elements}"
                        sim_infra1_lens_custom_function="${rs_infra1_lens_custom_function}"
                        sim_infra1_lens_intrinsics="${rs_infra1_lens_intrinsics}"
                        sim_infra1_lens_xy_skew="${rs_infra1_lens_xy_skew}"
                        sim_infra1_lens_projection="${rs_infra1_lens_projection}"
                        sim_infra1_distortion_k_p="${rs_infra1_distortion_k_p}"
                        sim_infra1_distortion_center="${rs_infra1_distortion_center}"
                        sim_infra1_gaussian_noise="${rs_infra1_gaussian_noise}"
                        sim_infra2_enabled="${rs_infra2_enabled}"
                        sim_infra2_use_gravity="${rs_infra2_use_gravity}"
                        sim_infra2_always_on="${rs_infra2_always_on}"
                        sim_infra2_visualize="${rs_infra2_visualize}"
                        sim_infra2_enable_metrics="${rs_infra2_enable_metrics}"
                        sim_infra2_save="${rs_infra2_save}"
                        sim_infra2_triggered="${rs_infra2_triggered}"
                        sim_infra2_visible_mask="${rs_infra2_visible_mask}"
                        sim_infra2_clip="${rs_infra2_clip}"
                        sim_infra2_update_rate="${rs_infra2_update_rate}"
                        sim_infra2_image="${rs_infra2_image}"
                        sim_infra2_lens_single_elements="${rs_infra2_lens_single_elements}"
                        sim_infra2_lens_custom_function="${rs_infra2_lens_custom_function}"
                        sim_infra2_lens_intrinsics="${rs_infra2_lens_intrinsics}"
                        sim_infra2_lens_xy_skew="${rs_infra2_lens_xy_skew}"
                        sim_infra2_lens_projection="${rs_infra2_lens_projection}"
                        sim_infra2_distortion_k_p="${rs_infra2_distortion_k_p}"
                        sim_infra2_distortion_center="${rs_infra2_distortion_center}"
                        sim_infra2_gaussian_noise="${rs_infra2_gaussian_noise}"
                        sim_color_image_topic="${rs_color_topic}"
                        sim_color_camera_info_topic="${rs_color_info_topic}"
                        sim_color_trigger_topic="${rs_color_trigger_topic}"
                        sim_depth_image_topic="${rs_depth_topic}"
                        sim_depth_camera_info_topic="${rs_depth_info_topic}"
                        sim_depth_trigger_topic="${rs_depth_trigger_topic}"
                        sim_infra1_image_topic="${rs_infra1_topic}"
                        sim_infra1_camera_info_topic="${rs_infra1_info_topic}"
                        sim_infra1_trigger_topic="${rs_infra1_trigger_topic}"
                        sim_infra2_image_topic="${rs_infra2_topic}"
                        sim_infra2_camera_info_topic="${rs_infra2_info_topic}"
                        sim_infra2_trigger_topic="${rs_infra2_trigger_topic}"/>
</robot>
