<?xml version="1.0"?>
<robot name="test_caster_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotics_description)/urdf/wheels/all_wheels.xacro"/>

  <link name="base_link"/>

  <!-- Option A: the vertical separation is expressed in rotation_joint. -->
  <xacro:caster_wheel name="caster_option_a"
                      parent_frame="base_link"
                      use_visual="false"
                      use_inertial="true"
                      radius="0.10"
                      length="0.04"
                      mass="1.0"
                      steering_joint_limits="20.0 200.0"
                      steering_joint_dynamics="0.1 0.2"
                      rotation_joint_limits="20.0 200.0"
                      rotation_joint_dynamics="0.1 0.2"
                      joint_parent_fr_wheel_fr="0.0 0.20 0.0 0.0 0.0 0.0"
                      x_joint_steering_fr_rotation_fr="-0.05"
                      z_joint_steering_fr_rotation_fr="-0.10"
                      sim_enabled="true"/>

  <!-- Option B: the vertical separation is expressed in steering_joint. -->
  <xacro:caster_wheel name="caster_option_b"
                      parent_frame="base_link"
                      use_visual="false"
                      use_inertial="true"
                      radius="0.10"
                      length="0.04"
                      mass="1.0"
                      steering_joint_limits="20.0 200.0"
                      steering_joint_dynamics="0.1 0.2"
                      rotation_joint_limits="20.0 200.0"
                      rotation_joint_dynamics="0.1 0.2"
                      joint_parent_fr_wheel_fr="0.0 -0.20 -0.10 0.0 0.0 0.0"
                      x_joint_steering_fr_rotation_fr="-0.05"
                      sim_enabled="false"/>
</robot>
