<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eut_robotics_description</name>
  <version>2.0.0</version>

  <description>URDF descriptions for Eurecat</description>

  <maintainer email="eutrob@eurecat.org">Eurecat</maintainer>
  <license>BSD-3-Clause</license>

  <url type="website">https://ice.eurecat.org/gitlab/robotics-automation/eut_robotics_description</url>
  <url type="repository">https://ice.eurecat.org/gitlab/robotics-automation/eut_robotics_description.git</url>
  <url type="bugtracker">https://ice.eurecat.org/gitlab/robotics-automation/eut_robotics_description/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- Launch and Python runtime deps used by launch/*.py and tools.py -->
   <!-- launch.actions, launch.substitutions, ... -->
  <exec_depend>launch</exec_depend>
  <!-- launch_ros.actions.Node, ComposableNode, ParameterValue, etc. -->
  <exec_depend>launch_ros</exec_depend>
  <!-- To use get_package_share_directory -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- PyYAML and Jinja2 used in ros2_control_sim.launch.py and others -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jinja2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
