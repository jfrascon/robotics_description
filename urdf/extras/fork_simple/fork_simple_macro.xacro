<?xml version="1.0"?>
<!--
This file defines the public `fork_simple` macro.

The macro publishes these links:
  - `${prefix}${name}_root_link`
  - `${prefix}${name}_carriage_link`
  - `${prefix}${name}_left_tine_stop_link`
  - `${prefix}${name}_left_tine_link`
  - `${prefix}${name}_right_tine_stop_link`
  - `${prefix}${name}_right_tine_link`

The macro publishes these joints:
  - one fixed joint from `parent_frame` to `${prefix}${name}_root_link`
  - one prismatic joint from `${prefix}${name}_root_link` to
    `${prefix}${name}_carriage_link`
  - four fixed joints from `${prefix}${name}_carriage_link` to the tine-stop and
    tine links

This macro does not resize the fork from a scale factor. The fork dimensions are
fixed in this file:
  - tine length, width, and thickness
  - tine separation
  - carriage size
  - tine mass, tine-stop mass, and carriage mass

Visual and collision are selected independently:
  - `use_visual` enables or disables all visual blocks
  - `use_collision` enables or disables all collision blocks
  - `use_v_mesh` selects mesh or primitive box for tine visual geometry
  - `use_c_mesh` selects mesh or primitive box for tine collision geometry

The carriage and both tine-stop links are always represented as primitive boxes.
The tine mesh path is fixed in this file and is not an external argument.

The `limits` argument is interpreted as `lower upper velocity effort`.
The `joint_parent_fr_root_fr` argument is interpreted as
`x y z roll pitch yaw`.
-->
<robot name="fork_simple_macro" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:macro name="fork_simple"
               params="name:='fork_simple'
                       prefix:=''
                       parent_frame
                       use_visual:=True
                       use_collision:=True
                       use_inertial:=True
                       use_v_mesh:=True
                       color:=''
                       use_c_mesh:=False
                       tine_open:=False
                       carriage_size_x:=0.06
                       carriage_size_z:=0.06
                       limits:='0.0 0.0 1000.0 1000.0'
                       joint_parent_fr_root_fr">

    <xacro:property name="tine_mesh"
                    value="robotics_description/meshes/extras/fork_tine/basic_open_tine_120.stl"/>

    <xacro:property name="tine_size_x"         value="1.20"/>
    <xacro:property name="tine_size_y"         value="0.12"/>
    <xacro:property name="tine_size_z"         value="0.06"/>
    <xacro:property name="tine_separation"     value="0.25"/>
    <xacro:property name="tine_mass"           value="20.0"/>
    <xacro:property name="tine_wall_thickness" value="0.001"/>

    <!--
    Check limits for the prismatic joint.
    -->
    <xacro:property name="limits_seq" value="${limits.split()}"/>

    <xacro:if value="${len(limits_seq) != 4}">
      ${xacro.fatal("fork_simple macro: invalid limits. Expected: 'lower upper velocity effort'")}
    </xacro:if>

    <xacro:property name="lower_limit"    value="${limits_seq[0]}"/>
    <xacro:property name="upper_limit"    value="${limits_seq[1]}"/>
    <xacro:property name="velocity_limit" value="${limits_seq[2]}"/>
    <xacro:property name="effort_limit"   value="${limits_seq[3]}"/>

    <!--
    The robot is spawned with this prismatic joint at q = 0. The lower limit must be at least
    0.005 m below q = 0 and the upper limit must be at least 0.005 m above q = 0.
    This keeps the spawned joint 5 mm away from each limit and gives the joint at least 1 cm
    of total motion.
    -->
    <xacro:if value="${float(lower_limit) > -0.005}">
      ${xacro.fatal("fork_simple macro: lower_limit must be &lt;= -0.005 m")}
    </xacro:if>

    <xacro:if value="${float(upper_limit) &lt; 0.005}">
      ${xacro.fatal("fork_simple macro: upper_limit must be >= 0.005 m")}
    </xacro:if>

    <xacro:if value="${effort_limit &lt;= 0.0 or velocity_limit &lt;= 0.0}">
      ${xacro.fatal("fork_simple macro: effort_limit and velocity_limit must be > 0")}
    </xacro:if>

    <!--
    The carriage is the part that joints the tines.
    A tine-shank is the vertical section above the tine that provides height and stability as the
    load is lifted.
    A mast is the vertical row along with the carriage + tines + tine-shanks slide up and down.
    There are two mast, left and right.
    -->
    <xacro:property name="carriage_size_y" value="${tine_separation}"/>

    <xacro:property name="v_color" value="${(prefix + name + '_color ' + color) if color != '' else ''}"/>

    <xacro:if value="${carriage_size_z &lt;= 0.0}">
      ${xacro.fatal("fork_simple macro: carriage_size_x must be > 0")}
    </xacro:if>

    <xacro:property name="tine_shank_size_x" value="${0.5 * tine_size_z}"/>
    <xacro:property name="tine_shank_size_y" value="${tine_size_y}"/>
    <xacro:property name="tine_shank_size_z" value="${2 * tine_size_z}"/>

    <!--
    mast_size_x + tine_stop_size_x (0.03) = carriage_size_x
    mast_size_x = carriage_size_x - tine_stop_size_x > 0
    Therefore, carriage_size_x must be > tine_stop_size_x, i.e.,
    if carriage_size_x <= tine_stop_size_x, then raise an error.
    To achive <=, an epsilon of 0.005 (5 mm) is added to tine_stop_size_x, so
    the check is:
    if carriage_size_x <= tine_stop_size_x + epsilon, then raise an error.

    -->
    <xacro:if value="${carriage_size_x &lt;= (tine_shank_size_x + 0.005)}">
      ${xacro.fatal("fork_simple macro: carriage_size_x must be > tine_shank_size_x")}
    </xacro:if>

    <!--
    Compute the carriage's mass in a simple way, just proportional to its size in x and z, so that
    a tine_size_x * tine_size_y * tine_size_z m carriage has a mass of 20 kg, which is reasonable
    for a steel box of that size.
    -->
    <xacro:property name="carriage_mass"
                    value="${20.0 * (carriage_size_x * carriage_size_z) / (tine_size_z * tine_size_z)}"/>

    <!-- At minimum mast_size_x is 0.005 m -->
    <xacro:property name="mast_size_x" value="${carriage_size_x - tine_shank_size_x}"/>
    <xacro:property name="mast_size_y" value="${tine_size_y}"/>
    <xacro:property name="mast_size_z" value="${upper_limit - lower_limit}"/>

    <!--
    Compute the mass of each mast in a simple way, just proportional to its size in x and z, so that
    a tine_size_x * tine_size_y * 1 m mast has a mass of 10 kg, which is reasonable for a steel box
    of that size.
    mass = 10 kg * (mast_size_x * tine_size_y * mast_size_z / tine_size_x * tine_size_y * 1 m) =
         = 10 kg * (mast_size_x * mast_size_z / tine_size_x)
    -->
    <xacro:property name="mast_mass" value="${10.0 * (mast_size_x * mast_size_z) / tine_size_x}"/>

    <link name="${prefix}${name}_root_link">
      <xacro:null_inertia/>
    </link>

    <xacro:property name="j" value="${joint_parent_fr_root_fr.split()}"/>

    <xacro:if value="${len(j) != 6}">
      ${xacro.fatal("fork_simple macro: invalid joint_parent_fr_root_fr. Expected: 'x y z roll pitch yaw'")}
    </xacro:if>

    <joint name="${prefix}${name}_root_joint" type="fixed">
      <parent link="${parent_frame}"/>
      <child link="${prefix}${name}_root_link"/>
      <origin rpy="${j[3]} ${j[4]} ${j[5]}" xyz="${j[0]} ${j[1]} ${j[2]}"/>
    </joint>

    <xacro:property name="carriage_origin_x" value="${-0.5 * carriage_size_x}"/>
    <xacro:property name="carriage_origin_y" value="0"/>
    <xacro:property name="carriage_origin_z" value="${-0.5 * carriage_size_z}"/>

    <link name="${prefix}${name}_carriage_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${carriage_size_x} ${carriage_size_y} ${carriage_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${carriage_origin_x} ${carriage_origin_y} ${carriage_origin_z}"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${carriage_size_x} ${carriage_size_y} ${carriage_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${carriage_origin_x} ${carriage_origin_y} ${carriage_origin_z}"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${carriage_mass}"
                                  size="${carriage_size_x} ${carriage_size_y} ${carriage_size_z}"
                                  origin="${carriage_origin_x} ${carriage_origin_y} ${carriage_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="carriage_mount_x" value="${carriage_size_x}"/>
    <xacro:property name="carriage_mount_y" value="0"/>
    <xacro:property name="carriage_mount_z" value="${carriage_size_z}"/>

    <joint name="${prefix}${name}_carriage_joint" type="prismatic">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_carriage_link"/>
      <origin rpy="0 0 0" xyz="${carriage_mount_x} ${carriage_mount_y} ${carriage_mount_z}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${lower_limit}"
             upper="${upper_limit}"
             effort="${effort_limit}"
             velocity="${velocity_limit}"/>
    </joint>

    <!-- Left tine link -->

    <xacro:property name="tine_origin_x" value="0"/>
    <xacro:property name="tine_origin_y" value="0"/>
    <xacro:property name="tine_origin_z" value="${-0.5 * tine_size_z}"/>

    <link name="${prefix}${name}_left_tine_link">
      <xacro:if value="${use_visual}">
        <xacro:visual_box mesh="${tine_mesh if use_v_mesh else ''}"
                          scale="1.0 1.0 1.0"
                          mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                          shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          color="${v_color}"/>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <xacro:collision_box mesh="${tine_mesh if use_c_mesh else ''}"
                             scale="1.0 1.0 1.0"
                             mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                             size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                             shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${tine_mass}"
                                  size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                                  origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="left_tine_mount_x" value="${0.5 * (tine_size_x - carriage_size_x)}"/>
    <xacro:property name="left_tine_mount_y" value="${0.5*(tine_separation + tine_size_y)}"/>
    <xacro:property name="left_tine_mount_z" value="${-carriage_size_z + tine_size_z}"/>

    <joint name="${prefix}${name}_left_tine_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_left_tine_link"/>
      <origin rpy="0 0 0" xyz="${left_tine_mount_x} ${left_tine_mount_y} ${left_tine_mount_z}"/>
    </joint>

    <!-- Bottom plate link for the left tine -->

    <!--
    The link is located in the middle of the bottom face of the plate.
    -->
    <xacro:property name="tine_bottom_plate_origin_z" value="${0.5 * tine_wall_thickness}"/>

    <link name="${prefix}${name}_left_tine_bottom_plate_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${tine_size_x} ${tine_size_y} ${tine_wall_thickness}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 ${tine_bottom_plate_origin_z}"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${tine_size_x} ${tine_size_y} ${tine_wall_thickness}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 ${tine_bottom_plate_origin_z}"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${mast_mass}"
                                  size="${tine_size_x} ${tine_size_y} ${tine_wall_thickness}"
                                  origin="0 0 ${tine_bottom_plate_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="left_tine_bottom_plate_mount_x" value="${mast_size_x + (0.5 * tine_size_x)}"/>
    <xacro:property name="left_tine_bottom_plate_mount_y" value="${0.5*(tine_separation + tine_size_y)}"/>
    <xacro:property name="left_tine_bottom_plate_mount_z" value="0"/>

    <joint name="${prefix}${name}_left_tine_bottom_plate_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_left_tine_bottom_plate_link"/>
      <origin rpy="0 0 0" xyz="${left_tine_bottom_plate_mount_x} ${left_tine_bottom_plate_mount_y} ${left_tine_bottom_plate_mount_z}"/>
    </joint>

    <!-- Front plate link for the left tine (when closed) -->

    <xacro:unless value="${tine_open}">
      <xacro:property name="front_tine_plate_size_x" value="${tine_wall_thickness}"/>
      <xacro:property name="front_tine_plate_size_y" value="${tine_size_y - 2*tine_wall_thickness}"/>
      <xacro:property name="front_tine_plate_size_z" value="${tine_size_z - 2*tine_wall_thickness}"/>
      <xacro:property name="front_tine_plate_origin_x" value="${-0.5 * front_tine_plate_size_x}"/>

      <link name="${prefix}${name}_left_tine_front_plate_link">
        <xacro:if value="${use_visual}">
          <visual>
            <geometry>
              <box size="${front_tine_plate_size_x} ${front_tine_plate_size_y} ${front_tine_plate_size_z}"/>
            </geometry>
            <origin rpy="0 0 0" xyz="${front_tine_plate_origin_x} 0 0"/>
            <xacro:if value="${color != ''}">
              <material name="${prefix}${name}_color">
                <color rgba="${color}"/>
              </material>
            </xacro:if>
          </visual>
        </xacro:if>

        <xacro:if value="${use_collision}">
          <collision>
            <geometry>
              <box size="${front_tine_plate_size_x} ${front_tine_plate_size_y} ${front_tine_plate_size_z}"/>
            </geometry>
            <origin rpy="0 0 0" xyz="${front_tine_plate_origin_x} 0 0"/>
          </collision>
        </xacro:if>

        <xacro:if value="${use_inertial}">
          <xacro:solid_box_inertia mass="0.1"
                                    size="${front_tine_plate_size_x} ${front_tine_plate_size_y} ${front_tine_plate_size_z}"
                                    origin="${front_tine_plate_origin_x} 0 0 0 0 0"/>
        </xacro:if>

        <xacro:unless value="${use_inertial}">
          <xacro:null_inertia/>
        </xacro:unless>
      </link>

      <xacro:property name="left_tine_front_plate_mount_x" value="${0.5 * tine_size_x}"/>
      <xacro:property name="left_tine_front_plate_mount_y" value="0"/>
      <xacro:property name="left_tine_front_plate_mount_z" value="${-0.5 * tine_size_z}"/>

      <joint name="${prefix}${name}_left_tine_front_plate_joint" type="fixed">
        <parent link="${prefix}${name}_left_tine_link"/>
        <child link="${prefix}${name}_left_tine_front_plate_link"/>
        <origin rpy="0 0 0" xyz="${left_tine_front_plate_mount_x} ${left_tine_front_plate_mount_y} ${left_tine_front_plate_mount_z}"/>
      </joint>
    </xacro:unless>

    <!-- Left tine-shank -->

    <link name="${prefix}${name}_left_tine_shank_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${tine_shank_size_x} ${tine_shank_size_y} ${tine_shank_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${tine_shank_size_x} ${tine_shank_size_y} ${tine_shank_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${mast_mass}"
                                  size="${tine_shank_size_x} ${tine_shank_size_y} ${tine_shank_size_z}"
                                  origin="0 0 0 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="left_tine_shank_mount_x" value="${-0.5 * tine_shank_size_x}"/>
    <xacro:property name="left_tine_shank_mount_y" value="${0.5*(tine_separation + tine_shank_size_y)}"/>
    <xacro:property name="left_tine_shank_mount_z"
                    value="${-carriage_size_z + tine_size_z + (0.5 * tine_shank_size_z)}"/>

    <joint name="${prefix}${name}_left_tine_shank_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_left_tine_shank_link"/>
      <origin rpy="0 0 0" xyz="${left_tine_shank_mount_x} ${left_tine_shank_mount_y} ${left_tine_shank_mount_z}"/>
    </joint>

   <!--
    Left mast
    -->

    <link name="${prefix}${name}_left_mast_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${mast_size_x} ${mast_size_y} ${mast_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${mast_size_x} ${mast_size_y} ${mast_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${mast_mass}"
                                  size="${mast_size_x} ${mast_size_y} ${mast_size_z}"
                                  origin="0 0 0 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="left_mast_mount_x" value="${0.5 * mast_size_x}"/>
    <xacro:property name="left_mast_mount_y" value="${0.5*(tine_separation + mast_size_y)}"/>
    <xacro:property name="left_mast_mount_z" value="${lower_limit + (0.5 * mast_size_z)}"/>

    <joint name="${prefix}${name}_left_mast_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_left_mast_link"/>
      <origin rpy="0 0 0" xyz="${left_mast_mount_x} ${left_mast_mount_y} ${left_mast_mount_z}"/>
    </joint>

    <!-- Right tine link -->

    <xacro:property name="tine_origin_x" value="0"/>
    <xacro:property name="tine_origin_y" value="0"/>
    <xacro:property name="tine_origin_z" value="${-0.5 * tine_size_z}"/>

    <link name="${prefix}${name}_right_tine_link">
      <xacro:if value="${use_visual}">
        <xacro:visual_box mesh="${tine_mesh if use_v_mesh else ''}"
                          scale="1.0 1.0 1.0"
                          mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                          shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          color="${v_color}"/>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <xacro:collision_box mesh="${tine_mesh if use_c_mesh else ''}"
                             scale="1.0 1.0 1.0"
                             mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                             size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                             shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${tine_mass}"
                                  size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                                  origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="right_tine_mount_x" value="${left_tine_mount_x}"/>
    <xacro:property name="right_tine_mount_y" value="${-left_tine_mount_y}"/>
    <xacro:property name="right_tine_mount_z" value="${left_tine_mount_z}"/>

    <joint name="${prefix}${name}_right_tine_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_right_tine_link"/>
      <origin rpy="0 0 0" xyz="${right_tine_mount_x} ${right_tine_mount_y} ${right_tine_mount_z}"/>
    </joint>


    <!-- Bottom plate link for the right tine -->

    <!--
    The link is located in the middle of the bottom face of the plate.
    -->
    <xacro:property name="tine_bottom_plate_origin_z" value="${0.5 * tine_wall_thickness}"/>

    <link name="${prefix}${name}_right_tine_bottom_plate_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${tine_size_x} ${tine_size_y} ${tine_wall_thickness}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 ${tine_bottom_plate_origin_z}"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${tine_size_x} ${tine_size_y} ${tine_wall_thickness}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 ${tine_bottom_plate_origin_z}"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${mast_mass}"
                                  size="${tine_size_x} ${tine_size_y} ${tine_wall_thickness}"
                                  origin="0 0 ${tine_bottom_plate_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="right_tine_bottom_plate_mount_x" value="${left_tine_bottom_plate_mount_x}"/>
    <xacro:property name="right_tine_bottom_plate_mount_y" value="${-left_tine_bottom_plate_mount_y}"/>
    <xacro:property name="right_tine_bottom_plate_mount_z" value="${left_tine_bottom_plate_mount_z}"/>

    <joint name="${prefix}${name}_right_tine_bottom_plate_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_right_tine_bottom_plate_link"/>
      <origin rpy="0 0 0" xyz="${right_tine_bottom_plate_mount_x} ${right_tine_bottom_plate_mount_y} ${right_tine_bottom_plate_mount_z}"/>
    </joint>

    <!-- Front plate link for the right tine (when closed) -->

    <xacro:unless value="${tine_open}">
      <link name="${prefix}${name}_right_tine_front_plate_link">
        <xacro:if value="${use_visual}">
          <visual>
            <geometry>
              <box size="${front_tine_plate_size_x} ${front_tine_plate_size_y} ${front_tine_plate_size_z}"/>
            </geometry>
            <origin rpy="0 0 0" xyz="${front_tine_plate_origin_x} 0 0"/>
            <xacro:if value="${color != ''}">
              <material name="${prefix}${name}_color">
                <color rgba="${color}"/>
              </material>
            </xacro:if>
          </visual>
        </xacro:if>

        <xacro:if value="${use_collision}">
          <collision>
            <geometry>
              <box size="${front_tine_plate_size_x} ${front_tine_plate_size_y} ${front_tine_plate_size_z}"/>
            </geometry>
            <origin rpy="0 0 0" xyz="${front_tine_plate_origin_x} 0 0"/>
          </collision>
        </xacro:if>

        <xacro:if value="${use_inertial}">
          <xacro:solid_box_inertia mass="0.1"
                                    size="${front_tine_plate_size_x} ${front_tine_plate_size_y} ${front_tine_plate_size_z}"
                                    origin="${front_tine_plate_origin_x} 0 0 0 0 0"/>
        </xacro:if>

        <xacro:unless value="${use_inertial}">
          <xacro:null_inertia/>
        </xacro:unless>
      </link>

      <xacro:property name="right_tine_front_plate_mount_x" value="${left_tine_front_plate_mount_x}"/>
      <xacro:property name="right_tine_front_plate_mount_y" value="0"/>
      <xacro:property name="right_tine_front_plate_mount_z" value="${left_tine_front_plate_mount_z}"/>

      <joint name="${prefix}${name}_right_tine_front_plate_joint" type="fixed">
        <parent link="${prefix}${name}_right_tine_link"/>
        <child link="${prefix}${name}_right_tine_front_plate_link"/>
        <origin rpy="0 0 0" xyz="${right_tine_front_plate_mount_x} ${right_tine_front_plate_mount_y} ${right_tine_front_plate_mount_z}"/>
      </joint>
    </xacro:unless>

    <!-- Right tine-shank -->

    <link name="${prefix}${name}_right_tine_shank_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${tine_shank_size_x} ${tine_shank_size_y} ${tine_shank_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${tine_shank_size_x} ${tine_shank_size_y} ${tine_shank_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${mast_mass}"
                                  size="${tine_shank_size_x} ${tine_shank_size_y} ${tine_shank_size_z}"
                                  origin="0 0 0 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="right_tine_shank_mount_x" value="${left_tine_shank_mount_x}"/>
    <xacro:property name="right_tine_shank_mount_y" value="${-left_tine_shank_mount_y}"/>
    <xacro:property name="right_tine_shank_mount_z" value="${left_tine_shank_mount_z}"/>

    <joint name="${prefix}${name}_right_tine_shank_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_right_tine_shank_link"/>
      <origin rpy="0 0 0" xyz="${right_tine_shank_mount_x} ${right_tine_shank_mount_y} ${right_tine_shank_mount_z}"/>
    </joint>

   <!--
    Right mast
    -->

    <link name="${prefix}${name}_right_mast_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${mast_size_x} ${mast_size_y} ${mast_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${mast_size_x} ${mast_size_y} ${mast_size_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="0 0 0"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertia mass="${mast_mass}"
                                  size="${mast_size_x} ${mast_size_y} ${mast_size_z}"
                                  origin="0 0 0 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="right_mast_mount_x" value="${left_mast_mount_x}"/>
    <xacro:property name="right_mast_mount_y" value="${-left_mast_mount_y}"/>
    <xacro:property name="right_mast_mount_z" value="${left_mast_mount_z}"/>

    <joint name="${prefix}${name}_right_mast_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_right_mast_link"/>
      <origin rpy="0 0 0" xyz="${right_mast_mount_x} ${right_mast_mount_y} ${right_mast_mount_z}"/>
    </joint>

  </xacro:macro>
</robot>
