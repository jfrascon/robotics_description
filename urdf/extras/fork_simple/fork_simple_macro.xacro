<?xml version="1.0"?>
<!--
This file defines the public `fork_simple` macro.

The macro publishes these links:
  - `${prefix}${name}_root_link`
  - `${prefix}${name}_carriage_link`
  - `${prefix}${name}_left_tine_stop_link`
  - `${prefix}${name}_left_tine_link`
  - `${prefix}${name}_right_tine_stop_link`
  - `${prefix}${name}_right_tine_link`

The macro publishes these joints:
  - one fixed joint from `parent_frame` to `${prefix}${name}_root_link`
  - one prismatic joint from `${prefix}${name}_root_link` to
    `${prefix}${name}_carriage_link`
  - four fixed joints from `${prefix}${name}_carriage_link` to the tine-stop and
    tine links

This macro does not resize the fork from a scale factor. The fork dimensions are
fixed in this file:
  - tine length, width, and thickness
  - tine separation
  - carriage size
  - tine mass, tine-stop mass, and carriage mass

Visual and collision are selected independently:
  - `use_visual` enables or disables all visual blocks
  - `use_collision` enables or disables all collision blocks
  - `use_v_mesh` selects mesh or primitive box for tine visual geometry
  - `use_c_mesh` selects mesh or primitive box for tine collision geometry

The carriage and both tine-stop links are always represented as primitive boxes.
The tine mesh path is fixed in this file and is not an external argument.

The `limits` argument is interpreted as `lower upper velocity effort`.
The `joint_parent_fr_root_fr` argument is interpreted as
`x y z roll pitch yaw`.
-->
<robot name="fork_simple" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:macro name="fork_simple"
               params="name:='fork_simple'
                       prefix:=''
                       parent_frame
                       use_visual:=True
                       use_collision:=True
                       use_inertial:=True
                       use_v_mesh:=True
                       color:=''
                       use_c_mesh:=False
                       carriage_len_x:='0.03'
                       carriage_len_y
                       limits:='0.0 0.0 1000.0 1000.0'
                       joint_parent_fr_root_fr">

    <xacro:property name="tine_mesh"
                    value="robotics_description/meshes/extras/fork_tine/basic_open_tine_120.stl"/>

    <xacro:property name="tine_size_x"     value="1.20"/>
    <xacro:property name="tine_size_y"     value="0.12"/>
    <xacro:property name="tine_size_z"     value="0.06"/>
    <xacro:property name="tine_separation" value="0.25"/>
    <xacro:property name="tine_mass"       value="20.0"/>
    <xacro:property name="min_carriage_len_y"
                    value="${tine_separation + (2 * tine_size_y)}"/>

    <xacro:property name="v_color" value="${(prefix + name + '_color ' + color) if color != '' else ''}"/>

    <xacro:if value="${float(carriage_len_x) &lt;= 0.0}">
      ${xacro.fatal("fork_simple macro: carriage_len_x must be > 0")}
    </xacro:if>

    <xacro:if value="${float(carriage_len_y) &lt; min_carriage_len_y}">
      ${xacro.fatal("fork_simple macro: carriage_len_y must be at least tine_separation + 2*tine_size_y")}
    </xacro:if>

    <!--
    Use 20 kg when `carriage_len_y == min_carriage_len_y`.
    For larger carriage widths, scale the carriage mass linearly with `carriage_len_y`.
    -->
    <xacro:property name="carriage_mass" value="${20.0 * (float(carriage_len_y) / min_carriage_len_y)}"/>

    <!--
    Use 10 kg when `carriage_len_x == 0.06`.
    For larger or smaller carriage lengths, scale the tine-stop mass linearly with
    `carriage_len_x`.
    -->
    <xacro:property name="tine_stop_mass" value="${10.0 * (float(carriage_len_x) / 0.06)}"/>

    <link name="${prefix}${name}_root_link">
      <xacro:null_inertia/>
    </link>

    <xacro:property name="j" value="${joint_parent_fr_root_fr.split()}"/>

    <xacro:if value="${len(j) != 6}">
      ${xacro.fatal("fork_simple macro: invalid joint_parent_fr_root_fr. Expected: 'x y z roll pitch yaw'")}
    </xacro:if>

    <joint name="${prefix}${name}_root_joint" type="fixed">
      <parent link="${parent_frame}"/>
      <child link="${prefix}${name}_root_link"/>
      <origin rpy="${j[3]} ${j[4]} ${j[5]}" xyz="${j[0]} ${j[1]} ${j[2]}"/>
    </joint>

    <!--
    The carriage is the part moved by the prismatic joint.
    Both tine links and both tine-stop links are attached to the carriage with fixed
    joints, so they move together with the carriage.
    -->
    <xacro:property name="carriage_len_z" value="${tine_size_z}"/>

    <xacro:property name="carriage_origin_x" value="${0.5 * carriage_len_x}"/>
    <xacro:property name="carriage_origin_y" value="0"/>
    <xacro:property name="carriage_origin_z" value="${0.5 * tine_size_z}"/>

    <link name="${prefix}${name}_carriage_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${carriage_len_x} ${carriage_len_y} ${carriage_len_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${carriage_origin_x} ${carriage_origin_y} ${carriage_origin_z}"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${carriage_len_x} ${carriage_len_y} ${carriage_len_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${carriage_origin_x} ${carriage_origin_y} ${carriage_origin_z}"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertial mass="${carriage_mass}"
                                  size="${carriage_len_x} ${carriage_len_y} ${carriage_len_z}"
                                  origin="${carriage_origin_x} ${carriage_origin_y} ${carriage_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="limits_seq" value="${limits.split()}"/>

    <xacro:if value="${len(limits_seq) != 4}">
      ${xacro.fatal("fork_simple macro: invalid limits. Expected: 'lower upper velocity effort'")}
    </xacro:if>

    <xacro:property name="lower_limit"    value="${float(limits_seq[0])}"/>
    <xacro:property name="upper_limit"    value="${float(limits_seq[1])}"/>
    <xacro:property name="velocity_limit" value="${float(limits_seq[2])}"/>
    <xacro:property name="effort_limit"   value="${float(limits_seq[3])}"/>

    <xacro:if value="${lower_limit > upper_limit}">
      ${xacro.fatal("fork_simple macro: lower_limit must be &lt;= upper_limit")}
    </xacro:if>

    <xacro:if value="${effort_limit &lt;= 0.0 or velocity_limit &lt;= 0.0}">
      ${xacro.fatal("fork_simple macro: effort_limit and velocity_limit must be > 0")}
    </xacro:if>

    <joint name="${prefix}${name}_carriage_joint" type="prismatic">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_carriage_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${lower_limit}"
             upper="${upper_limit}"
             effort="${effort_limit}"
             velocity="${velocity_limit}"/>
    </joint>

    <!-- Left tine-stop link. This is the rear stop box for the left tine. -->

    <xacro:property name="tine_stop_len_x" value="${carriage_len_x}"/>
    <xacro:property name="tine_stop_len_y" value="${tine_size_y}"/>
    <xacro:property name="tine_stop_len_z" value="${2 * tine_size_z}"/>

    <xacro:property name="tine_stop_origin_x" value="${-0.5 * tine_stop_len_x}"/>
    <xacro:property name="tine_stop_origin_y" value="0"/>
    <xacro:property name="tine_stop_origin_z" value="0"/>

    <link name="${prefix}${name}_left_tine_stop_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${tine_stop_len_x} ${tine_stop_len_y} ${tine_stop_len_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${tine_stop_origin_x} ${tine_stop_origin_y} ${tine_stop_origin_z}"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${tine_stop_len_x} ${tine_stop_len_y} ${tine_stop_len_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${tine_stop_origin_x} ${tine_stop_origin_y} ${tine_stop_origin_z}"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertial mass="${tine_stop_mass}"
                                  size="${tine_stop_len_x} ${tine_stop_len_y} ${tine_stop_len_z}"
                                  origin="${tine_stop_origin_x} ${tine_stop_origin_y} ${tine_stop_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="tine_stop_mount_x" value="${carriage_len_x}"/>
    <xacro:property name="tine_stop_mount_y" value="${0.5*(tine_separation + tine_size_y)}"/>
    <xacro:property name="tine_stop_mount_z" value="${2*tine_size_z}"/>

    <joint name="${prefix}${name}_left_tine_stop_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_left_tine_stop_link"/>
      <origin rpy="0 0 0" xyz="${tine_stop_mount_x} ${tine_stop_mount_y} ${tine_stop_mount_z}"/>
    </joint>

    <!-- Left tine link. This is the main load-bearing tine geometry. -->

    <xacro:property name="tine_origin_x" value="0"/>
    <xacro:property name="tine_origin_y" value="0"/>
    <xacro:property name="tine_origin_z" value="${-0.5 * tine_size_z}"/>

    <link name="${prefix}${name}_left_tine_link">
      <xacro:if value="${use_visual}">
        <xacro:visual_box mesh="${tine_mesh if use_v_mesh else ''}"
                          scale="1.0 1.0 1.0"
                          mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                          shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          color="${v_color}"/>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <xacro:collision_box mesh="${tine_mesh if use_c_mesh else ''}"
                             scale="1.0 1.0 1.0"
                             mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                             size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                             shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertial mass="${tine_mass}"
                                  size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                                  origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="tine_mount_x" value="${tine_stop_mount_x + (0.5 * tine_size_x)}"/>
    <xacro:property name="tine_mount_y" value="${tine_stop_mount_y}"/>
    <xacro:property name="tine_mount_z" value="${tine_size_z}"/>

    <joint name="${prefix}${name}_left_tine_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_left_tine_link"/>
      <origin rpy="0 0 0" xyz="${tine_mount_x} ${tine_mount_y} ${tine_mount_z}"/>
    </joint>

    <!-- Right tine-stop link. This is the rear stop box for the right tine. -->

    <link name="${prefix}${name}_right_tine_stop_link">
      <xacro:if value="${use_visual}">
        <visual>
          <geometry>
            <box size="${tine_stop_len_x} ${tine_stop_len_y} ${tine_stop_len_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${tine_stop_origin_x} ${tine_stop_origin_y} ${tine_stop_origin_z}"/>
          <xacro:if value="${color != ''}">
            <material name="${prefix}${name}_color">
              <color rgba="${color}"/>
            </material>
          </xacro:if>
        </visual>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <collision>
          <geometry>
            <box size="${tine_stop_len_x} ${tine_stop_len_y} ${tine_stop_len_z}"/>
          </geometry>
          <origin rpy="0 0 0" xyz="${tine_stop_origin_x} ${tine_stop_origin_y} ${tine_stop_origin_z}"/>
        </collision>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertial mass="${tine_stop_mass}"
                                  size="${tine_stop_len_x} ${tine_stop_len_y} ${tine_stop_len_z}"
                                  origin="${tine_stop_origin_x} ${tine_stop_origin_y} ${tine_stop_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <joint name="${prefix}${name}_right_tine_stop_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_right_tine_stop_link"/>
      <origin rpy="0 0 0" xyz="${tine_stop_mount_x} ${-tine_stop_mount_y} ${tine_stop_mount_z}"/>
    </joint>

    <!-- Right tine link. This is the main load-bearing tine geometry. -->

    <link name="${prefix}${name}_right_tine_link">
      <xacro:if value="${use_visual}">
        <xacro:visual_box mesh="${tine_mesh if use_v_mesh else ''}"
                          scale="1.0 1.0 1.0"
                          mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                          shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                          color="${v_color}"/>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <xacro:collision_box mesh="${tine_mesh if use_c_mesh else ''}"
                             scale="1.0 1.0 1.0"
                             mesh_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"
                             size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                             shape_origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:solid_box_inertial mass="${tine_mass}"
                                  size="${tine_size_x} ${tine_size_y} ${tine_size_z}"
                                  origin="${tine_origin_x} ${tine_origin_y} ${tine_origin_z} 0 0 0"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <joint name="${prefix}${name}_right_tine_joint" type="fixed">
      <parent link="${prefix}${name}_carriage_link"/>
      <child link="${prefix}${name}_right_tine_link"/>
      <origin rpy="0 0 0" xyz="${tine_mount_x} ${-tine_mount_y} ${tine_mount_z}"/>
    </joint>
  </xacro:macro>
</robot>
