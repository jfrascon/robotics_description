<?xml version="1.0"?>
<!--
This file defines a specific fork model macro, `fork_simple_0`.
It reuses the generic `fork_simple` macro and provides fixed, model-specific values for geometry, mesh path, and
inertial properties.

Mesh path:
robotics_description/meshes/extras/fork_simple/fork_simple_0/fork_simple_0.stl

Companion MeshLab report:
robotics_description/meshes/extras/fork_simple/fork_simple_0/meshlab_geometric_measures.txt

Inertia-scaling procedure:
robotics_description/doc/how_to_compute_inertia_w_meshlab.md
MeshLab works with rho=1 (it does not model a specific material here).
With rho=1, the reference mass is mass_ref = mesh volume (computed by MeshLab).
To obtain inertia tensors for the target mass `mass`, scale each tensor component by
s = mass / mass_ref.
In this macro, the target mass used for scaling is mass = 100.0 kg.
-->
<robot name="fork_simple_0" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- Import generic simplified fork macro. -->
  <xacro:include filename="$(find robotics_description)/urdf/extras/fork_simple/fork_simple_macro.xacro"/>

  <xacro:macro name="fork_simple_0"
               params="name:='fork_simple_0'
                       prefix:=''
                       parent_frame
                       use_inertial:=True
                       color:='0.0 0.0 0.0 1.0'
                       limits:='0.0 0.0 1000.0 1000.0'
                       joint_parent_fr_root_fr">

    <!--
    Model-specific mesh path (package-relative, without package:// prefix).
    The mesh frame is expected to follow the generator convention:
    - Origin: rear face of the tine union, centered in Y, on the bottom plane.
    - +X: from the rear union plate toward the tine tips.
    - +Y: side where the left tine is built (right tine is mirrored to -Y).
    - +Z: upward.
    Therefore, when integrating this fork model on a robot, `joint_parent_fr_root_fr` must be chosen
    consistently with that frame convention.
    -->
    <xacro:property name="mesh" value="robotics_description/meshes/extras/fork_simple/fork_simple_0/fork_simple_0.stl"/>

    <!-- Geometry constants of fork_simple_0 (meters), matching script defaults. -->
    <xacro:property name="tine_size"         value="1.20 0.12 0.06"/>
    <xacro:property name="tine_separation"   value="0.25"/>
    <xacro:property name="tine_union_size_x" value="0.03"/>

    <!-- Path for simulation setups where inertial data is intentionally disabled. -->
    <xacro:unless value="${use_inertial}">
      <xacro:fork_simple name="${name}"
                         prefix="${prefix}"
                         parent_frame="${parent_frame}"
                         mesh="${mesh}"
                         color="${color}"
                         tine_size="${tine_size}"
                         tine_separation="${tine_separation}"
                         tine_union_size_x="${tine_union_size_x}"
                         limits="${limits}"
                         joint_parent_fr_root_fr="${joint_parent_fr_root_fr}"/>
    </xacro:unless>

    <!-- Inertial path: compute scaled tensor from MeshLab reference values and pass it to fork_simple. -->
    <xacro:if value="${use_inertial}">
      <!--
      Compute inertia elements by scaling the reference values reported by MeshLab.
      MeshLab uses rho=1 kg/m^3 (it does not model a specific material here), so mass_ref = mesh volume.
      Following doc/how_to_compute_inertia_w_meshlab.md:
        mass_ref = V_meshlab
        s = mass_real / mass_ref
        I_real_ij = s * I_ref_ij
      -->
      <xacro:property name="mass"            value="100.0"/>
      <xacro:property name="center_of_mass"  value="0.571591 0.000000 0.031427"/>
      <xacro:property name="mesh_volume_ref" value="0.018162"/>
      <xacro:property name="s"               value="${mass / mesh_volume_ref}"/>

      <xacro:property name="ixx_ref" value="0.000637"/>
      <xacro:property name="ixy_ref" value="0.000000"/>
      <xacro:property name="ixz_ref" value="0.000014"/>
      <xacro:property name="iyy_ref" value="0.002368"/>
      <xacro:property name="iyz_ref" value="0.000000"/>
      <xacro:property name="izz_ref" value="0.002991"/>

      <xacro:property name="ixx" value="${s * ixx_ref}"/>
      <xacro:property name="ixy" value="${s * ixy_ref}"/>
      <xacro:property name="ixz" value="${s * ixz_ref}"/>
      <xacro:property name="iyy" value="${s * iyy_ref}"/>
      <xacro:property name="iyz" value="${s * iyz_ref}"/>
      <xacro:property name="izz" value="${s * izz_ref}"/>
      <xacro:property name="inertial_elements" value="${ixx} ${ixy} ${ixz} ${iyy} ${iyz} ${izz}"/>

      <xacro:fork_simple name="${name}"
                         prefix="${prefix}"
                         parent_frame="${parent_frame}"
                         mesh="${mesh}"
                         color="${color}"
                         mass="${mass}"
                         tine_size="${tine_size}"
                         tine_separation="${tine_separation}"
                         tine_union_size_x="${tine_union_size_x}"
                         inertial_elements="${inertial_elements}"
                         center_of_mass="${center_of_mass}"
                         limits="${limits}"
                         joint_parent_fr_root_fr="${joint_parent_fr_root_fr}"/>
    </xacro:if>
  </xacro:macro>
</robot>
