<?xml version="1.0"?>
<!--
This macro provides the links-and-joints structure used by `fork_simple_legacy`.
It is retained temporarily with the legacy wrapper and is not used by the current `fork_simple`.
It is designed to work with a `fork_simple` mesh generated by
`meshes/extras/fork_simple/fork_simple_stl_generator.py`.

Design choice:
- A mesh is required; there is no primitive-box fallback.
  Building an equivalent fork from Xacro/URDF primitives requires multiple shapes and offsets.
  The generated mesh keeps the geometry representative and lightweight for simulation.

Intended usage:
- This macro is the links-and-joints base for `fork_simple_legacy` only.
- The legacy wrapper passes the final geometry and inertial values for the selected mesh variant.

Important scope of responsibility:
- `mesh_scale` only scales the visual and collision mesh loaded by this macro.
- This macro does not derive any other quantity from `mesh_scale`.
- Geometry values such as `tine_size`, `tine_separation` and `tine_union_size_x` must already be
  scaled by the caller.
- Inertial quantities must also correspond to the final scaled fork instance.
- `mesh_scale` scales only the displayed and collision mesh; it is not a general resizing parameter.

Convention for parameter types:
R means real number (with decimal point)
I means integer (without decimal point)
S means string (any sequence of characters)
B means boolean (true or false)

name (S): base name for links and joints created by the macro.

prefix (S): optional prefix prepended to all generated link/joint names.

parent_frame (S): parent link/frame name for `${prefix}${name}_root_joint`.

mesh (S): mesh filename resolved as package URI (for example
    'robotics_description/meshes/extras/fork_simple/fork_simple_20260219.stl'),
    used for both visual and collision (required).

mesh_scale (S): scale applied only to the mesh loaded in visual and collision.
    mesh_scale (S) = 'sx (R) sy (R) sz (R)'.
    This parameter does not rescale any other magnitude used by the macro.

color (S): RGBA string for the visual material.
  color (S) = 'r (R) g (R) b (R) a (R)'.

mass (R): total mass of the fork body. Required only when `inertial_elements` is provided.

tine_size (S): tine bounding-box size used for tine offset calculations:
    tine_size (S) = 'sx (R) sy (R) sz (R)'.

tine_separation (R): distance between inner faces of left/right tines.

tine_union_size_x (R): X offset from `${prefix}${name}_root_link` to `${prefix}${name}_link`.

inertial_elements (S): inertia tensor of the fork mesh, associated to `${prefix}${name}_root_link`
    and expressed in that same link frame. Values must correspond to the real body mass
    (i.e., already scaled to the real mass), not raw values computed with rho=1
    (rho is material density in kg/m^3).
    inertial_elements (S) = 'ixx (R) ixy (R) ixz (R) iyy (R) iyz (R) izz (R)'.
    If empty, `<xacro:null_inertia/>` is used.

center_of_mass (S): center of mass position for the inertial origin.
    center_of_mass (S) = 'x (R) y (R) z (R)'.
    Must be provided if `inertial_elements` is provided.

limits (S): prismatic joint limits for `${prefix}${name}_root_joint`.
    limits (S) = 'lower (R) upper (R) velocity (R) effort (R)'.

joint_parent_fr_root_fr (S): pose of root frame with respect to `parent_frame`.
    joint_parent_fr_root_fr (S) = 'x (R) y (R) z (R) roll (R) pitch (R) yaw (R)'.

-->

<robot name="fork_simple_links_joints_legacy_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotics_description)/urdf/common/all_commons.xacro"/>

  <xacro:macro name="fork_simple_links_joints_legacy"
               params="name
                       prefix:=''
                       parent_frame
                       mesh
                       mesh_scale:='1.0 1.0 1.0'
                       color:='0.0 0.0 0.0 1.0'
                       mass:=''
                       tine_size:='0.0 0.0 0.0'
                       tine_separation:='0.0'
                       tine_union_size_x:=0.0
                       inertial_elements:=''
                       center_of_mass:=''
                       limits:='0.0 0.0 0.0 0.0'
                       joint_parent_fr_root_fr">

    <xacro:if value="${mesh.strip() == ''}">
      ${xacro.fatal("fork_simple_links_joints_legacy: mesh must not be empty")}
    </xacro:if>

    <xacro:property name="mesh_scale_items" value="${mesh_scale.split()}"/>
    <xacro:property name="tine_size_items" value="${tine_size.split()}"/>

    <xacro:if value="${len(mesh_scale_items) != 3}">
      ${xacro.fatal("fork_simple_links_joints_legacy: mesh_scale must be 'sx sy sz'")}
    </xacro:if>

    <xacro:if value="${len(tine_size_items) != 3}">
      ${xacro.fatal("fork_simple_links_joints_legacy: tine_size must be 'sx sy sz'")}
    </xacro:if>

    <!-- Convert strings to floats before validation and frame-offset calculations. -->
    <xacro:property name="mesh_scale_x"          value="${float(mesh_scale_items[0])}"/>
    <xacro:property name="mesh_scale_y"          value="${float(mesh_scale_items[1])}"/>
    <xacro:property name="mesh_scale_z"          value="${float(mesh_scale_items[2])}"/>
    <xacro:property name="tine_size_x"           value="${float(tine_size_items[0])}"/>
    <xacro:property name="tine_size_y"           value="${float(tine_size_items[1])}"/>
    <xacro:property name="tine_size_z"           value="${float(tine_size_items[2])}"/>
    <xacro:property name="tine_separation_val"   value="${float(tine_separation)}"/>
    <xacro:property name="tine_union_size_x_val" value="${float(tine_union_size_x)}"/>

    <xacro:if value="${mesh_scale_x &lt;= 0.0 or mesh_scale_y &lt;= 0.0 or mesh_scale_z &lt;= 0.0}">
      ${xacro.fatal("fork_simple_links_joints_legacy: mesh_scale values must be greater than zero")}
    </xacro:if>

    <xacro:if value="${tine_size_x &lt;= 0.0 or tine_size_y &lt;= 0.0 or tine_size_z &lt;= 0.0}">
      ${xacro.fatal("fork_simple_links_joints_legacy: tine_size values must be greater than zero")}
    </xacro:if>

    <xacro:if value="${tine_separation_val &lt; 0.0}">
      ${xacro.fatal("fork_simple_links_joints_legacy: tine_separation must be non-negative")}
    </xacro:if>

    <xacro:if value="${tine_union_size_x_val &lt; 0.0}">
      ${xacro.fatal("fork_simple_links_joints_legacy: tine_union_size_x must be non-negative")}
    </xacro:if>

    <!--
    Expected mesh frame convention (for STL generated by `fork_simple_stl_generator.py`):
    - Origin: rear face of the tine union, centered in Y, on the bottom plane.
    - +X: from the rear union plate toward the tine tips.
    - +Y: side where the left tine is built (right tine is mirrored to -Y).
    - +Z: upward.
    The wrapper places this frame relative to the robot through `joint_parent_fr_root_fr`.
    Visual and collision mesh origins therefore remain identity transforms.
    A wrapper that scales the mesh must also pass the final scaled geometry and inertial quantities.
    mesh_scale then makes the visual and collision mesh match those final values.
    -->
    <xacro:property name="visual_color"
                    value="${(prefix + name + '_color ' + color) if color != '' else ''}"/>

    <link name="${prefix}${name}_root_link">
      <xacro:visual_mesh mesh="${mesh}"
                         scale="${mesh_scale_x} ${mesh_scale_y} ${mesh_scale_z}"
                         mesh_origin="0 0 0 0 0 0"
                         color="${visual_color}"/>
      <xacro:collision_mesh mesh="${mesh}"
                            scale="${mesh_scale_x} ${mesh_scale_y} ${mesh_scale_z}"
                            mesh_origin="0 0 0 0 0 0"/>

      <xacro:if value="${inertial_elements.strip() != ''}">
        <xacro:property name="inertia_items" value="${inertial_elements.split()}"/>
        <xacro:property name="center_of_mass_items" value="${center_of_mass.split()}"/>

        <xacro:if value="${len(inertia_items) != 6}">
          ${xacro.fatal("fork_simple_links_joints_legacy: inertial_elements must be 'ixx ixy ixz iyy iyz izz'")}
        </xacro:if>

        <xacro:if value="${len(center_of_mass_items) != 3}">
          ${xacro.fatal("fork_simple_links_joints_legacy: center_of_mass must be 'x y z'")}
        </xacro:if>

        <xacro:if value="${str(mass).strip() == ''}">
          ${xacro.fatal("fork_simple_links_joints_legacy: mass is required with inertial_elements")}
        </xacro:if>

        <xacro:if value="${float(mass) &lt;= 0.0}">
          ${xacro.fatal("fork_simple_links_joints_legacy: mass must be greater than zero with inertial_elements")}
        </xacro:if>

        <inertial>
          <mass value="${mass}"/>
          <inertia ixx="${inertia_items[0]}" ixy="${inertia_items[1]}" ixz="${inertia_items[2]}"
                   iyy="${inertia_items[3]}" iyz="${inertia_items[4]}"
                   izz="${inertia_items[5]}"/>
          <origin rpy="0 0 0"
                  xyz="${center_of_mass_items[0]} ${center_of_mass_items[1]} ${center_of_mass_items[2]}"/>
        </inertial>
      </xacro:if>

      <xacro:if value="${inertial_elements.strip() == ''}">
        <xacro:null_inertia/>
      </xacro:if>
    </link>

    <xacro:property name="limit_items" value="${limits.split()}"/>

    <xacro:if value="${len(limit_items) != 4}">
      ${xacro.fatal("fork_simple_links_joints_legacy: limits must be 'lower upper velocity effort'")}
    </xacro:if>

    <xacro:property name="lower_limit"    value="${float(limit_items[0])}"/>
    <xacro:property name="upper_limit"    value="${float(limit_items[1])}"/>
    <xacro:property name="velocity_limit" value="${float(limit_items[2])}"/>
    <xacro:property name="effort_limit"   value="${float(limit_items[3])}"/>

    <xacro:if value="${lower_limit > upper_limit}">
      ${xacro.fatal("fork_simple_links_joints_legacy: lower_limit must be less than or equal to upper_limit")}
    </xacro:if>

    <xacro:if value="${effort_limit &lt;= 0.0 or velocity_limit &lt;= 0.0}">
      ${xacro.fatal("fork_simple_links_joints_legacy: effort and velocity limits must be greater than zero")}
    </xacro:if>

    <xacro:property name="parent_root_items" value="${joint_parent_fr_root_fr.split()}"/>

    <xacro:if value="${len(parent_root_items) != 6}">
      ${xacro.fatal("fork_simple_links_joints_legacy: joint_parent_fr_root_fr must be 'x y z roll pitch yaw'")}
    </xacro:if>

    <joint name="${prefix}${name}_root_joint" type="prismatic">
      <parent link="${parent_frame}"/>
      <child link="${prefix}${name}_root_link"/>
      <origin rpy="${parent_root_items[3]} ${parent_root_items[4]} ${parent_root_items[5]}"
              xyz="${parent_root_items[0]} ${parent_root_items[1]} ${parent_root_items[2]}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${lower_limit}"
             upper="${upper_limit}"
             effort="${effort_limit}"
             velocity="${velocity_limit}"/>
    </joint>

    <link name="${prefix}${name}_link">
      <xacro:null_inertia/>
    </link>

    <joint name="${prefix}${name}_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_link"/>
      <origin rpy="0 0 0" xyz="${tine_union_size_x_val} 0 ${tine_size_z}"/>
    </joint>

    <link name="${prefix}${name}_left_tine_link">
      <xacro:null_inertia/>
    </link>

    <joint name="${prefix}${name}_left_tine_joint" type="fixed">
      <parent link="${prefix}${name}_link"/>
      <child link="${prefix}${name}_left_tine_link"/>
      <origin rpy="0 0 0" xyz="${tine_size_x/2} ${tine_separation_val/2 + tine_size_y/2} 0"/>
    </joint>

    <link name="${prefix}${name}_right_tine_link">
      <xacro:null_inertia/>
    </link>

    <joint name="${prefix}${name}_right_tine_joint" type="fixed">
      <parent link="${prefix}${name}_link"/>
      <child link="${prefix}${name}_right_tine_link"/>
      <origin rpy="0 0 0" xyz="${tine_size_x/2} ${-tine_separation_val/2 - tine_size_y/2} 0"/>
    </joint>
  </xacro:macro>
</robot>
