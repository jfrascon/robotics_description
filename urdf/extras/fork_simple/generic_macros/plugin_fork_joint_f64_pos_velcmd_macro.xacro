<?xml version="1.0"?>
<!--
The `plugin_fork_joint_f64_pos_velcmd` macro defines a Gazebo Sim `JointPositionController`
system plugin for one fork prismatic joint.

This variant uses:
- `std_msgs/msg/Float64` as the command transport
- position commands from the plugin topic
- velocity-command mode for `JointPositionController` (`use_velocity_commands` is true)

The `joint_limits` parameter is expected in the same format used by the fork macro:
- `joint_limits = 'lower (R) upper (R) velocity (R) effort (R)'`

This macro uses that parameter to:
- validate the expected limits format
- compute the default initial position as the middle point between the lower and upper limits
- clamp the requested tracking speed to the velocity limit declared in the fork joint

This macro publishes no data and creates no links or joints. It only emits the `<plugin>` block
that can be injected from a robot macro or xacro file.

Reference:
https://gazebosim.org/api/sim/10/classgz_1_1sim_1_1systems_1_1JointPositionController.html
-->
<robot name="plugin_fork_joint_f64_pos_velcmd" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:macro name="plugin_fork_joint_f64_pos_velcmd"
               params="joint_name
                       joint_limits
                       vel_max:=''
                       initial_position:=''
                       namespace
                       topic">

    <xacro:include filename="$(find robotics_description)/urdf/common/resolve_topic_macro.xacro"/>
    <xacro:include filename="$(find robotics_description)/urdf/gz_system_plugins/plugin_joint_position_controller_f64_pos_velcmd_macro.xacro"/>

    <xacro:property name="joint_limits_seq" value="${joint_limits.split()}"/>

    <xacro:if value="${len(joint_limits_seq) != 4}">
      ${xacro.fatal("plugin_fork_joint_f64_pos_velcmd: joint_limits must have 4 elements: 'lower (R) upper (R) velocity (R) effort (R)'")}
    </xacro:if>

    <xacro:property name="default_initial_position"
                    value="${0.5 * (float(joint_limits_seq[0]) + float(joint_limits_seq[1]))}"/>

    <xacro:property name="resolved_initial_position"
                    value="${initial_position if initial_position != '' else default_initial_position}"/>

    <!-- Clamp the requested tracking speed to the velocity limit declared in the fork joint. -->
    <xacro:property name="resolved_vel_max"
                    value="${min(float(vel_max), float(joint_limits_seq[2])) if vel_max != '' else float(joint_limits_seq[2])}"/>

    <xacro:resolve_topic prop_id="resolved_topic"
                         topic="${topic}"
                         namespace="${namespace}"/>

    <xacro:plugin_joint_position_controller_f64_pos_velcmd
      joint_name="${joint_name}"
      joint_index="0"
      cmd_max="${resolved_vel_max}"
      initial_position="${resolved_initial_position}"
      topic="${resolved_topic}"/>
  </xacro:macro>
</robot>
