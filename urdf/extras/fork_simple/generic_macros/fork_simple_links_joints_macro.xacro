<!--
This macro provides the generic links-and-joints structure for a simplified forklift fork.
It is designed to work with a `fork_simple` mesh generated by
`meshes/extras/fork_simple/fork_simple_stl_generator.py`.

Design choice:
- A mesh is required (no primitive-box fallback). Building an equivalent fork from basic Xacro/URDF primitives
  requires combining multiple shapes and offsets, which adds unnecessary complexity even for a simple model.
  The generated mesh keeps the geometry representative while remaining lightweight for visual and collision use
  in simulation.

Intended usage:
- This macro is the reusable links-and-joints base for the `fork_simple` family.
- A model-specific macro (for a concrete fork model) should call it and pass the final parameter values already
  resolved for that concrete fork instance.

Important scope of responsibility:
- `mesh_scale` only scales the visual and collision mesh loaded by this macro.
- This macro does not derive any other quantity from `mesh_scale`.
- Geometry-related values such as `tine_size`, `tine_separation`, `tine_union_size_x`, and all inertial quantities
  must already be passed with the final values that correspond to the fork instance being described.
- In other words, `mesh_scale` is a mesh-display/collision scaling parameter, not a general fork-resizing parameter.

Convention for parameter types:
R means real number (with decimal point)
I means integer (without decimal point)
S means string (any sequence of characters)
B means boolean (true or false)

name (S): base name for links and joints created by the macro.

prefix (S): optional prefix prepended to all generated link/joint names.

parent_frame (S): parent link/frame name for `${prefix}${name}_root_joint`.

mesh (S): mesh filename resolved as package URI (for example
    'robotics_description/meshes/extras/fork_simple/fork_simple_20260219.stl'),
    used for both visual and collision (required).

mesh_scale (S): scale applied only to the mesh loaded in visual and collision.
    mesh_scale (S) = 'sx (R) sy (R) sz (R)'.
    This parameter does not rescale any other magnitude used by the macro.

color (S): RGBA string for the visual material.
  color (S) = 'r (R) g (R) b (R) a (R)'.

mass (R): total mass of the fork body. Required only when `inertial_elements` is provided.

tine_size (S): tine bounding-box size used for tine offset calculations:
    tine_size (S) = 'sx (R) sy (R) sz (R)'.

tine_separation (R): distance between inner faces of left/right tines.

tine_union_size_x (R): X offset from `${prefix}${name}_root_link` to `${prefix}${name}_link`.

inertial_elements (S): inertia tensor of the fork mesh, associated to `${prefix}${name}_root_link`
    and expressed in that same link frame. Values must correspond to the real body mass
    (i.e., already scaled to the real mass), not raw values computed with rho=1
    (rho is material density in kg/m^3).
    inertial_elements (S) = 'ixx (R) ixy (R) ixz (R) iyy (R) iyz (R) izz (R)'.
    If empty, `<xacro:null_inertia/>` is used.

center_of_mass (S): center of mass position for the inertial origin.
    center_of_mass (S) = 'x (R) y (R) z (R)'.
    Must be provided if `inertial_elements` is provided.

limits (S): prismatic joint limits for `${prefix}${name}_root_joint`.
    limits (S) = 'lower (R) upper (R) velocity (R) effort (R)'.

joint_parent_fr_root_fr (S): pose of root frame with respect to `parent_frame`.
    joint_parent_fr_root_fr (S) = 'x (R) y (R) z (R) roll (R) pitch (R) yaw (R)'.

-->

<robot name="fork_simple_links_joints_macro" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:macro name="fork_simple_links_joints"
               params="name
                       prefix:=''
                       parent_frame
                       mesh
                       mesh_scale:='1.0 1.0 1.0'
                       color:='0.0 0.0 0.0 1.0'
                       mass:=''
                       tine_size:='0.0 0.0 0.0'
                       tine_separation:='0.0'
                       tine_union_size_x:=0.0
                       inertial_elements:=''
                       center_of_mass:=''
                       limits:='0.0 0.0 0.0 0.0'
                       joint_parent_fr_root_fr">

    <xacro:include filename="$(find robotics_description)/urdf/common/all_commons.xacro"/>

    <xacro:if value="${mesh == ''}">
      ${xacro.fatal("fork_simple_links_joints macro: mesh must not be empty")}
    </xacro:if>

    <xacro:property name="mesh_scale_seq" value="${mesh_scale.split()}"/>
    <xacro:property name="tine_size_seq" value="${tine_size.split()}"/>

    <xacro:if value="${len(mesh_scale_seq) != 3}">
      ${xacro.fatal("fork_simple_links_joints macro: invalid mesh_scale. Expected: 'sx sy sz'")}
    </xacro:if>

    <xacro:if value="${len(tine_size_seq) != 3}">
      ${xacro.fatal("fork_simple_links_joints macro: invalid tine_size. Expected: 'sx sy sz'")}
    </xacro:if>

    <!-- Convert strings to floats before validating sizes and using them in frame-offset calculations. -->
    <xacro:property name="mesh_scale_x"          value="${float(mesh_scale_seq[0])}"/>
    <xacro:property name="mesh_scale_y"          value="${float(mesh_scale_seq[1])}"/>
    <xacro:property name="mesh_scale_z"          value="${float(mesh_scale_seq[2])}"/>
    <xacro:property name="tine_size_x"           value="${float(tine_size_seq[0])}"/>
    <xacro:property name="tine_size_y"           value="${float(tine_size_seq[1])}"/>
    <xacro:property name="tine_size_z"           value="${float(tine_size_seq[2])}"/>
    <xacro:property name="tine_separation_val"   value="${float(tine_separation)}"/>
    <xacro:property name="tine_union_size_x_val" value="${float(tine_union_size_x)}"/>

    <xacro:if value="${mesh_scale_x &lt;= 0.0 or mesh_scale_y &lt;= 0.0 or mesh_scale_z &lt;= 0.0}">
      ${xacro.fatal("fork_simple_links_joints macro: mesh_scale values must be > 0")}
    </xacro:if>

    <xacro:if value="${tine_size_x &lt;= 0.0 or tine_size_y &lt;= 0.0 or tine_size_z &lt;= 0.0}">
      ${xacro.fatal("fork_simple_links_joints macro: tine_size values must be > 0")}
    </xacro:if>

    <xacro:if value="${tine_separation_val &lt; 0.0}">
      ${xacro.fatal("fork_simple_links_joints macro: tine_separation must be >= 0")}
    </xacro:if>

    <xacro:if value="${tine_union_size_x_val &lt; 0.0}">
      ${xacro.fatal("fork_simple_links_joints macro: tine_union_size_x must be >= 0")}
    </xacro:if>

    <!--
    Expected mesh frame convention (for STL generated by `fork_simple_stl_generator.py`):
    - Origin: rear face of the tine union, centered in Y, on the bottom plane.
    - +X: from the rear union plate toward the tine tips.
    - +Y: side where the left tine is built (right tine is mirrored to -Y).
    - +Z: upward.
    This frame placement is appropriate for robot integration with parent-frame offsets
    (typically defined in model-specific wrappers through `joint_parent_fr_root_fr`),
    so visual and collision mesh origins are kept as identity transforms: xyz="0 0 0", rpy="0 0 0".
    If a model-specific wrapper wants to reuse the same mesh as a geometrically scaled variant,
    it must pass the final geometry and inertial quantities already scaled, and then use `mesh_scale`
    only so the rendered and collision mesh matches those final values.
    -->
    <link name="${prefix}${name}_root_link">
      <visual>
        <geometry>
          <mesh filename="package://${mesh}" scale="${mesh_scale_x} ${mesh_scale_y} ${mesh_scale_z}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <material name="${prefix}${name}_color">
          <color rgba="${color}"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <mesh filename="package://${mesh}" scale="${mesh_scale_x} ${mesh_scale_y} ${mesh_scale_z}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0"/>
      </collision>

      <xacro:if value="${inertial_elements != ''}">
        <xacro:property name="inertia_seq" value="${inertial_elements.split()}"/>
        <xacro:property name="com_seq" value="${center_of_mass.split()}"/>

        <xacro:if value="${len(inertia_seq) != 6}">
          ${xacro.fatal("fork_simple_links_joints macro: invalid inertial_elements. Expected: 'ixx ixy ixz iyy iyz izz'")}
        </xacro:if>

        <xacro:if value="${len(com_seq) != 3}">
          ${xacro.fatal("fork_simple_links_joints macro: invalid center_of_mass. Expected: 'x y z'")}
        </xacro:if>

        <xacro:if value="${mass == ''}">
          ${xacro.fatal("fork_simple_links_joints macro: mass must be provided when inertial_elements are provided")}
        </xacro:if>

        <xacro:if value="${float(mass) &lt;= 0.0}">
          ${xacro.fatal("fork_simple_links_joints macro: mass must be > 0 when inertial_elements are provided")}
        </xacro:if>

        <inertial>
          <mass value="${mass}"/>
          <inertia ixx="${inertia_seq[0]}" ixy="${inertia_seq[1]}" ixz="${inertia_seq[2]}"
                   iyy="${inertia_seq[3]}" iyz="${inertia_seq[4]}"
                   izz="${inertia_seq[5]}"/>
          <origin rpy="0 0 0" xyz="${com_seq[0]} ${com_seq[1]} ${com_seq[2]}"/>
        </inertial>
      </xacro:if>

      <xacro:if value="${inertial_elements == ''}">
        <xacro:null_inertia/>
      </xacro:if>
    </link>

    <xacro:property name="limits_seq" value="${limits.split()}"/>

    <xacro:if value="${len(limits_seq) != 4}">
      ${xacro.fatal("fork_simple_links_joints macro: invalid limits. Expected: 'lower upper velocity effort'")}
    </xacro:if>

    <xacro:property name="lower_limit"    value="${float(limits_seq[0])}"/>
    <xacro:property name="upper_limit"    value="${float(limits_seq[1])}"/>
    <xacro:property name="velocity_limit" value="${float(limits_seq[2])}"/>
    <xacro:property name="effort_limit"   value="${float(limits_seq[3])}"/>

    <xacro:if value="${lower_limit > upper_limit}">
      ${xacro.fatal("fork_simple_links_joints macro: lower_limit must be &lt;= upper_limit")}
    </xacro:if>

    <xacro:if value="${effort_limit &lt;= 0.0 or velocity_limit &lt;= 0.0}">
      ${xacro.fatal("fork_simple_links_joints macro: effort_limit and velocity_limit must be > 0")}
    </xacro:if>

    <xacro:property name="j" value="${joint_parent_fr_root_fr.split()}"/>

    <xacro:if value="${len(j) != 6}">
      ${xacro.fatal("fork_simple_links_joints macro: invalid joint_parent_fr_root_fr. Expected: 'x y z roll pitch yaw'")}
    </xacro:if>

    <joint name="${prefix}${name}_root_joint" type="prismatic">
      <parent link="${parent_frame}"/>
      <child link="${prefix}${name}_root_link"/>
      <origin rpy="${j[3]} ${j[4]} ${j[5]}" xyz="${j[0]} ${j[1]} ${j[2]}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${lower_limit}"
             upper="${upper_limit}"
             effort="${effort_limit}"
             velocity="${velocity_limit}"/>
    </joint>

    <link name="${prefix}${name}_link">
      <xacro:null_inertia/>
    </link>

    <joint name="${prefix}${name}_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_link"/>
      <origin rpy="0 0 0" xyz="${tine_union_size_x_val} 0 ${tine_size_z}"/>
    </joint>

    <link name="${prefix}${name}_left_tine_link">
      <xacro:null_inertia/>
    </link>

    <joint name="${prefix}${name}_left_tine_joint" type="fixed">
      <parent link="${prefix}${name}_link"/>
      <child link="${prefix}${name}_left_tine_link"/>
      <origin rpy="0 0 0" xyz="${tine_size_x/2} ${tine_separation_val/2 + tine_size_y/2} 0"/>
    </joint>

    <link name="${prefix}${name}_right_tine_link">
      <xacro:null_inertia/>
    </link>

    <joint name="${prefix}${name}_right_tine_joint" type="fixed">
      <parent link="${prefix}${name}_link"/>
      <child link="${prefix}${name}_right_tine_link"/>
      <origin rpy="0 0 0" xyz="${tine_size_x/2} ${-tine_separation_val/2 - tine_size_y/2} 0"/>
    </joint>
  </xacro:macro>
</robot>
