<?xml version="1.0"?>
<!--
Convention for parameter types:
S means string
-->
<robot name="basket_macros" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotics_description)/urdf/common/all_commons.xacro"/>

  <xacro:property name="basket_chassis_mesh"
                  value="robotics_description/meshes/extras/basket/basket_chassis.stl"/>
  <xacro:property name="basket_container_mesh"
                  value="robotics_description/meshes/extras/basket/basket_container.stl"/>

  <!--
  Macro for the basket chassis only.
  joint_parent_fr_basket_fr (S): Basket chassis pose relative to parent.
      joint_parent_fr_basket_fr (S) = 'x y z roll pitch yaw'
  color (S): Optional material in the form '<color_name> r g b a'.
             If empty, the mesh may use its embedded color.
  -->
  <xacro:macro name="basket_chassis_macro"
               params="prefix
                       parent
                       joint_parent_fr_basket_fr:='0 0 0 0 0 0'
                       color:=''">
    <joint name="${prefix}basket_chassis_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <xacro:origin_element origin="${joint_parent_fr_basket_fr}"/>
      <parent link="${parent}"/>
      <child link="${prefix}basket_chassis_link"/>
    </joint>

    <link name="${prefix}basket_chassis_link">
      <xacro:visual_mesh mesh="${basket_chassis_mesh}" color="${color}"/>
      <xacro:collision_mesh mesh="${basket_chassis_mesh}"/>
      <xacro:null_inertia/>
    </link>

    <gazebo reference="${prefix}basket_chassis_link">
      <xacro:if value="${color != ''}">
        <xacro:property name="color_items" value="${color.split()}"/>

        <xacro:if value="${len(color_items) != 5}">
          ${xacro.fatal("basket_chassis_macro: color must be 'color_name r g b a'")}
        </xacro:if>

        <material>
          <ambient>${color_items[1]} ${color_items[2]} ${color_items[3]} ${color_items[4]}</ambient>
          <diffuse>${color_items[1]} ${color_items[2]} ${color_items[3]} ${color_items[4]}</diffuse>
        </material>
      </xacro:if>
      <gravity>true</gravity>
    </gazebo>
  </xacro:macro>

  <!--
  Macro for the basket container only.
  joint_parent_fr_container_fr (S): Basket container pose relative to parent.
      joint_parent_fr_container_fr (S) = 'x y z roll pitch yaw'
  color (S): Optional material in the form '<color_name> r g b a'.
             If empty, the mesh may use its embedded color.
  -->
  <xacro:macro name="basket_container_macro"
               params="prefix
                       parent
                       joint_parent_fr_container_fr:='-0.068 0 0.013 0 0 0'
                       color:=''">
    <joint name="${prefix}basket_container_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <xacro:origin_element origin="${joint_parent_fr_container_fr}"/>
      <parent link="${parent}"/>
      <child link="${prefix}basket_container_link"/>
    </joint>

    <link name="${prefix}basket_container_link">
      <xacro:null_inertia/>
      <xacro:visual_mesh mesh="${basket_container_mesh}" color="${color}"/>
      <xacro:collision_mesh mesh="${basket_container_mesh}"/>
    </link>

    <gazebo reference="${prefix}basket_container_link">
      <xacro:if value="${color != ''}">
        <xacro:property name="color_items" value="${color.split()}"/>

        <xacro:if value="${len(color_items) != 5}">
          ${xacro.fatal("basket_container_macro: color must be 'color_name r g b a'")}
        </xacro:if>

        <material>
          <ambient>${color_items[1]} ${color_items[2]} ${color_items[3]} ${color_items[4]}</ambient>
          <diffuse>${color_items[1]} ${color_items[2]} ${color_items[3]} ${color_items[4]}</diffuse>
        </material>
      </xacro:if>
      <gravity>true</gravity>
    </gazebo>
  </xacro:macro>

  <!--
  Macro for the complete legacy basket assembly.
  The container offset keeps the old RB-VOGUI value until the container STL frame is normalized.
  -->
  <xacro:macro name="basket_full_macro"
               params="prefix
                       parent
                       joint_parent_fr_basket_fr:='0 0 0 0 0 0'
                       joint_basket_fr_container_fr:='-0.068 0 0.013 0 0 0'
                       basket_chassis_color:=''
                       basket_container_color:=''">
    <xacro:basket_chassis_macro prefix="${prefix}"
                                parent="${parent}"
                                joint_parent_fr_basket_fr="${joint_parent_fr_basket_fr}"
                                color="${basket_chassis_color}"/>

    <xacro:basket_container_macro prefix="${prefix}"
                                  parent="${prefix}basket_chassis_link"
                                  joint_parent_fr_container_fr="${joint_basket_fr_container_fr}"
                                  color="${basket_container_color}"/>
  </xacro:macro>
</robot>
