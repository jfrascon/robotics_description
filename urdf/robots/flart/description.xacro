<?xml version="1.0"?>
<!--
The name of the robot model, 'flart', is obtained from the combination of the words 'forklift' and 'artisteril',
which is the company that manufactures the forklift robot.
-->
<robot name="flart" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="pkg_dir"    value="$(find eut_robotics_description)"/>
  <xacro:property name="config_dir" value="${pkg_dir}/config"/>
  <xacro:property name="urdf_dir"   value="${pkg_dir}/urdf"/>

  <!-- INCLUDES -->

  <xacro:include filename="${urdf_dir}/common/all_commons.xacro"/>
  <xacro:include filename="${urdf_dir}/bases/rectangular_body_macro.xacro"/>
  <xacro:include filename="${urdf_dir}/bases/set_rectangular_body_props_macro.xacro"/>
  <xacro:include filename="${urdf_dir}/wheels/wheel_macro.xacro"/>
  <xacro:include filename="${urdf_dir}/wheels/set_wheel_props_macro.xacro"/>
  <xacro:include filename="${urdf_dir}/extras/fork_macro.xacro"/>
  <xacro:include filename="${urdf_dir}/extras/set_fork_props_macro.xacro"/>
  <xacro:include filename="${urdf_dir}/sensors/all_sensors_macro.xacro"/>

  <!--
  An input configuration file can be provided when instantiating this xacro file.
  If no input configuration file is provided, the default configuration file is used.
  -->
  <xacro:property name="desc_cfg" value="${xacro.load_yaml(config_dir + '/robots/flart/description.yaml')}"/>

  <!-- ===================================================================== -->
  <!-- ARGS -->
  <!-- ===================================================================== -->
  <xacro:arg name="robot_name"           default="${desc_cfg['name']}"/>
  <xacro:arg name="namespace"            default=""/>
  <xacro:arg name="use_visual_meshes"    default="True"/>
  <xacro:arg name="use_collision_meshes" default="False"/>
  <xacro:arg name="use_sim_mode"         default="False"/>
  <xacro:arg name="sim_cfg_file"         default=""/>

  <!--
  Create properties from args for easy manipulation.
  -->

  <!-- args into properties for easy manipulation -->
  <xacro:property name="robname" value="$(arg robot_name)"/>
  <xacro:property name="ns"      value="$(arg namespace)"/>

  <xacro:property name="robot_namespace"
                  value="${(ns + robname) if ns in ('', '/') else (ns.rstrip('/') + '/' + robname)}"/>
  <xacro:property name="robot_prefix" value="${robname + '_'}"/>

  <xacro:property name="use_visual_meshes"    value="$(arg use_visual_meshes)"/>
  <xacro:property name="use_collision_meshes" value="$(arg use_collision_meshes)"/>
  <xacro:property name="use_sim_mode"         value="$(arg use_sim_mode)"/>

  <!--
  If not working in simulation mode, do not load the simulation configuration for the robot from the simulation
  configuration file.
  If working in simulation mode, but no configuration file is provided, set an empty dictionary, meaning no
  configuration is available.
  -->
  <xacro:property name="sim_cfg_file" value="$(arg sim_cfg_file)"/>

  <!--
  If the 'use_sim_mode' argument is True, then the 'sim_cfg_file' argument is required (non-empty).
  -->
  <xacro:if value="${use_sim_mode and not sim_cfg_file}">
    ${xacro.fatal("The argument 'sim_cfg_file' is empty while 'use_sim_mode' is set to True")}
  </xacro:if>

  <xacro:property name="sim_cfg" value="${xacro.load_yaml(sim_cfg_file) if use_sim_mode else dict()}"/>

  <!-- ===================================================================== -->
  <!-- ROBOT -->
  <!-- ===================================================================== -->

  <!--
  Names used in this robot for devices/parts:
  - base
  - front_left_wheel
  - front_right_wheel
  - rear_left_wheel
  - rear_right_wheel
  - fork
  - front_lidar
  - front_imu
  -->

  <xacro:property name="robot_size_x" value="${desc_cfg['size']['x']}"/>
  <xacro:property name="robot_size_y" value="${desc_cfg['size']['y']}"/>
  <xacro:property name="robot_size_z" value="${desc_cfg['size']['z']}"/>

  <!-- ===================================================================== -->
  <!-- MECANUM RECTANGULAR BASE -->
  <!-- ===================================================================== -->
  <!--
  A base is composed of a body and wheels.
  In this case, the base is rectangular with mecanum wheels.

  The rectangular_body macro defines the following links and joints:
  - Links:
    * ${prefix}${name}_footprint_link = ${robot_prefix}${base_name}_footprint_link
    * ${prefix}${name}_link = ${robot_prefix}${base_name}_link
  - Joints:
    * ${prefix}${name}_joint = ${robot_prefix}${base_name}_joint, joining the links
      ${robot_prefix}${base_name}_footprint_link and ${robot_prefix}${base_name}_link.

  THE LINK '${robot_prefix}${base_name}_link' IS LOCATED AT THE CENTER OF THE BOTTOM FACE OF THE BASE BODY.

  THE LINK '${robot_prefix}${base_name}_footprint_link' IS LOCATED ON THE GROUND, JUST BELOW THE LINK
  '${robot_prefix}${base_name}_link'.
  ANOTHER WAY TO SEE IS, THE LINK '${robot_prefix}${base_name}_footprint_link' IS LOCATED ON THE GROUND, AND THE LINK
  '${robot_prefix}${base_name}_link' IS JUST OVER IT, AT A HEIGHT OF 'GROUND_CLEARANCE' METERS.
  -->

  <xacro:property name="base_name"              value="base"/>
  <xacro:property name="front_left_wheel_name"  value="front_left_wheel"/>  <!-- flw -->
  <xacro:property name="front_right_wheel_name" value="front_right_wheel"/> <!-- frw -->
  <xacro:property name="rear_left_wheel_name"   value="rear_left_wheel"/>   <!-- rlw -->
  <xacro:property name="rear_right_wheel_name"  value="rear_right_wheel"/>  <!-- rrw -->

  <xacro:set_rectangular_body_props desc_cfg="${desc_cfg['base']['body']}" prop_prefix="base_body"/>
  <xacro:property name="base_body_half_wheelbase"   value="${0.5 * base_body_wheelbase}"/>
  <xacro:property name="base_body_half_track_width" value="${0.5 * base_body_track_width}"/>

  <xacro:rectangular_body
    name="${base_name}"
    prefix="${robot_prefix}"
    mass="${base_body_mass}"
    size="${base_body_size_x} ${base_body_size_y} ${base_body_size_z}"
    ground_clearance="${base_body_ground_clearance}"
    mesh_visual="${base_body_mesh_visual if use_visual_meshes else ''}"
    mesh_visual_has_color="${base_body_mesh_visual_has_color}"
    color="${base_body_color}"
    mesh_collision="${base_body_mesh_collision if use_collision_meshes else ''}"
    scale="${base_body_scale}"/>

  <!--
  Definition of the four mecanum wheels.
  -->

  <xacro:set_wheel_props desc_cfg="${desc_cfg['base']['wheel']}" prop_prefix="wheel"/>

  <!--
  The front left and the rear right mecanum wheels are of the same type, left type.
  The front right and the rear left mecanum wheels are of the same type, right type.
  The left and right meshes for the same mecanum wheel model are supposed to be called '<side>_xxx.stl'
  where {{side}} is either 'left' or 'right', and 'xxx' is the rest of the file name.
  Therefore, in the property '${prop_prefix}_mesh_visual', we could have and empty value (no mesh) or a value like
  '/path/to/meshes/{{side}}_<whatever>'.ext'

  Next, we get the left and right mesh names by replacing {{side}} with 'left' and 'right', respectively, if a non-empty
  mesh name is provided. If no mesh name is provided, the left and right mesh names are also empty.
  -->

  <xacro:property name="wheel_mesh_visual_left"
                  value="${wheel_mesh_visual.replace('[side]', 'left') if wheel_mesh_visual else ''}"/>

  <xacro:property name="wheel_mesh_visual_right"
                  value="${wheel_mesh_visual.replace('[side]', 'right') if wheel_mesh_visual else ''}"/>

  <xacro:property name="z_wheel" value="${-base_body_ground_clearance + wheel_radius}"/>

  <xacro:wheel
    name="${front_left_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    mass="${wheel_mass}"
    shape="${wheel_shape}"
    velocity_limit="${wheel_velocity_limit}"
    effort_limit="${wheel_effort_limit}"
    max_contacts="${wheel_max_contacts}"
    mu="${wheel_mu}"
    mu2="${wheel_mu2}"
    slip1="${wheel_slip1}"
    slip2="${wheel_slip2}"
    mesh_visual="${wheel_mesh_visual_left}"
    mesh_visual_has_color="${wheel_mesh_visual_has_color}"
    color="${wheel_color}"
    scale="${wheel_scale}"
    joint_parent_fr_wheel_fr="${base_body_half_wheelbase} ${base_body_half_track_width} ${z_wheel} 0 0 0"
    base_root_fr="${robot_prefix}${base_name}_footprint_link"
    fdir1_base_root_fr="${cos(radians(45))} ${sin(radians(45))} 0"/>

  <xacro:wheel
    name="${front_right_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    mass="${wheel_mass}"
    shape="${wheel_shape}"
    velocity_limit="${wheel_velocity_limit}"
    effort_limit="${wheel_effort_limit}"
    max_contacts="${wheel_max_contacts}"
    mu="${wheel_mu}"
    mu2="${wheel_mu2}"
    slip1="${wheel_slip1}"
    slip2="${wheel_slip2}"
    mesh_visual="${wheel_mesh_visual_right}"
    mesh_visual_has_color="${wheel_mesh_visual_has_color}"
    color="${wheel_color}"
    scale="${wheel_scale}"
    joint_parent_fr_wheel_fr="${base_body_half_wheelbase} ${-base_body_half_track_width} ${z_wheel} 0 0 0"
    base_root_fr="${robot_prefix}${base_name}_footprint_link"
    fdir1_base_root_fr="${-cos(radians(45))} ${sin(radians(45))} 0"/>

  <xacro:wheel
    name="${rear_left_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    mass="${wheel_mass}"
    shape="${wheel_shape}"
    velocity_limit="${wheel_velocity_limit}"
    effort_limit="${wheel_effort_limit}"
    max_contacts="${wheel_max_contacts}"
    mu="${wheel_mu}"
    mu2="${wheel_mu2}"
    slip1="${wheel_slip1}"
    slip2="${wheel_slip2}"
    mesh_visual="${wheel_mesh_visual_right}"
    mesh_visual_has_color="${wheel_mesh_visual_has_color}"
    color="${wheel_color}"
    scale="${wheel_scale}"
    joint_parent_fr_wheel_fr="${-base_body_half_wheelbase} ${base_body_half_track_width} ${z_wheel} 0 0 0"
    base_root_fr="${robot_prefix}${base_name}_footprint_link"
    fdir1_base_root_fr="${-cos(radians(45))} ${sin(radians(45))} 0"/>

  <xacro:wheel
    name="${rear_right_wheel_name}"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}${base_name}_link"
    mass="${wheel_mass}"
    shape="${wheel_shape}"
    velocity_limit="${wheel_velocity_limit}"
    effort_limit="${wheel_effort_limit}"
    max_contacts="${wheel_max_contacts}"
    mu="${wheel_mu}"
    mu2="${wheel_mu2}"
    slip1="${wheel_slip1}"
    slip2="${wheel_slip2}"
    mesh_visual="${wheel_mesh_visual_left}"
    mesh_visual_has_color="${wheel_mesh_visual_has_color}"
    color="${wheel_color}"
    scale="${wheel_scale}"
    joint_parent_fr_wheel_fr="${-base_body_half_wheelbase} ${-base_body_half_track_width} ${z_wheel} 0 0 0"
    base_root_fr="${robot_prefix}${base_name}_footprint_link"
    fdir1_base_root_fr="${cos(radians(45))} ${sin(radians(45))} 0"/>

  <!-- ===================================================================== -->
  <!-- FORK -->
  <!-- ===================================================================== -->

  <xacro:set_fork_props desc_cfg="${desc_cfg['fork']}" prop_prefix="fork"/>

  <!--
  padding_x, is the empty space between the edge of the base and the beginning of the tines.
  (Note: the tines start at the back face of the fork base)
  robot_size_x = base_body_size_x + padding_x + tine_size_x.
  padding_x = robot_size_x - base_body_size_x - tine_size_x.
  -->

  <xacro:property name="padding_x" value="${robot_size_x - base_body_size_x - fork_tine_size_x}"/>

  <xacro:property name="joint_base_fr_fork_fr_x"
                  value="${(-base_body_size_x * 0.5) - padding_x - fork_base_size_x}"/>

  <xacro:property name="joint_base_fr_fork_fr_z"
                  value="${-base_body_ground_clearance + fork_tine_size_z + fork_clearance_under_fork}"/>

    <xacro:fork
    name="fork"
    prefix="${robot_prefix}"
    parent_frame="${robot_prefix}base_link"
    use_inertia="${fork_use_inertia}"
    tine_mass="${fork_tine_mass}"
    tine_size="${fork_tine_size}"
    base_mass="${fork_base_mass}"
    base_size="${fork_base_size}"
    tine_separation="${fork_tine_separation}"
    lower_limit="${fork_lower_limit}"
    upper_limit="${fork_upper_limit}"
    brake_distance="${fork_brake_distance}"
    velocity_limit="${fork_velocity_limit}"
    velocity_limit_full_effort="${fork_velocity_limit_full_effort}"
    acceleration="${fork_acceleration}"
    max_load="${fork_max_load}"
    effort_tolerance="${fork_effort_tolerance}"
    dynamics_damping="${fork_dynamics_damping}"
    tine_mesh_visual="${fork_tine_mesh_visual if use_visual_meshes else ''}"
    tine_mesh_visual_has_color="${fork_tine_mesh_visual_has_color}"
    tine_mesh_collision="${fork_tine_mesh_collision if use_collision_meshes else ''}"
    tine_scale="${fork_tine_scale}"
    color="${fork_color}"
    joint_parent_fr_root_fr="${joint_base_fr_fork_fr_x} 0 ${joint_base_fr_fork_fr_z} 0 0 ${pi}"/>

  <!-- ===================================================================== -->
  <!-- TOP PLATFORM -->
  <!-- ===================================================================== -->

  <!-- (t)op (p)latform -->
  <xacro:property name="tp_mass"    value="1"/>
  <xacro:property name="tp_size_x"  value="0.08"/>
  <xacro:property name="tp_size_y"  value="0.08"/>
  <xacro:property name="tp_size_z"  value="0.146"/>
  <xacro:property name="tp_color"   value="0.1 0.1 0.1 1"/>

  <xacro:link_r
    name="top_platform"
    prefix="${robot_prefix}"
    mass="${tp_mass}"
    size="${tp_size_x} ${tp_size_y} ${tp_size_z}"
    color="${tp_color}"
    vci_pose="0 0 ${0.5 * tp_size_z} 0 0 0"/>

  <joint name="${robot_prefix}top_platform_joint" type="fixed">
    <parent link="${robot_prefix}base_link"/>
    <child link="${robot_prefix}top_platform_link"/>
    <origin rpy="0 0 0" xyz="-0.08629 0 ${base_body_size_z}"/>
  </joint>


  <!-- ===================================================================== -->
  <!-- SENSORS -->
  <!-- ===================================================================== -->

  <!--
  FRONT_LIDAR
  -->

  <!--
  Check to verify that the robot's configuration has the proper lidar model listed.
  -->

  <xacro:if value="${desc_cfg['front_lidar']['model'] != 'robosense_helios_16p'}">
    ${xacro.fatal("The 'front_lidar' model detected in the robot's configuration file is not a 'robosense_helios_16p'")}
  </xacro:if>

  <xacro:property name="front_lidar_cfg"
                  value="${xacro.load_yaml(config_dir + '/sensors/lidars/robosense_helios_16p.yaml')}"/>

  <xacro:property name="joint_base_fr_front_lidar_fr_x"
                  value="${(0.5 * base_body_size_x) + (0.5 * front_lidar_cfg['shape']['size']['x']) - 0.028}"/>

  <xacro:property name="front_lidar_sim_cfg" value="${sim_cfg.get('front_lidar', dict()) if use_sim_mode else dict()}"/>

  <xacro:robosense_helios_16p
    name="front_lidar"
    prefix="${robot_prefix}"
    namespace="${robot_namespace}"
    parent_frame="${robot_prefix}base_link"
    joint_parent_fr_root_fr="${joint_base_fr_front_lidar_fr_x} 0 0.28 0 0 0"
    sim_cfg="${front_lidar_sim_cfg if front_lidar_sim_cfg.get('enabled', False) else None}"
    use_mesh_visual="${use_visual_meshes}"
    use_mesh_collision="${use_collision_meshes}"/>

  <!-- FRONT IMU -->

  <!--
  Check to verify that the robot's configuration has the proper imu model listed.
  -->

  <xacro:if value="${desc_cfg['front_imu']['model'] != 'um7'}">
    ${xacro.fatal("The 'front_imu' model detected in the robot's configuration file is not a 'um7'")}
  </xacro:if>


  <!--
  Position and orientation of the frame '${robot_prefix}front_imu_root_link' with respect to the frame
  '${robot_prefix}front_lidar_root_link'.
  -->

  <xacro:property name="joint_front_lidar_fr_front_imu_fr"
                  value="0 0 ${front_lidar_cfg['shape']['size']['z']} 0 0 0"/>

  <xacro:property name="front_imu_sim_cfg" value="${sim_cfg.get('front_imu', dict()) if use_sim_mode else dict()}"/>

  <xacro:um7
    name="front_imu"
    prefix="${robot_prefix}"
    namespace="${robot_namespace}"
    parent_frame="${robot_prefix}front_lidar_root_link"
    joint_parent_fr_root_fr="${joint_front_lidar_fr_front_imu_fr}"
    sim_cfg="${front_imu_sim_cfg if front_imu_sim_cfg.get('enabled', False) else None}"
    use_mesh_visual="${use_visual_meshes}"
    use_mesh_collision="${use_collision_meshes}"/>

  <xacro:if value="${use_sim_mode}">
    <!--
    <xacro:include filename="${urdf_dir}/robots/flart/ros2_control_sim.xacro"/>
    <xacro:r2c namespace="${robot_namespace}"
               fork_joint_name="${robot_prefix}fork_root_joint"
               front_left_wheel_joint_name="${robot_prefix}front_left_wheel_joint"
               front_right_wheel_joint_name="${robot_prefix}front_right_wheel_joint"
               rear_left_wheel_joint_name="${robot_prefix}rear_left_wheel_joint"
               rear_right_wheel_joint_name="${robot_prefix}rear_right_wheel_joint"/>
  </xacro:if>
</robot>
