<?xml version="1.0"?>
<!--
NavSat simulation configuration adapter.

The macro converts an optional YAML-derived dictionary into flat Xacro properties in the caller
scope. Xacro evaluates the expressions inside `${...}` as Python. The surrounding `xacro:if`,
`xacro:unless`, and `xacro:property` elements control which properties are generated.

Every generated property uses prop_prefix and scope="parent". This lets the higher-level GNSS
macro read the values after set_props_plugin_navsat finishes expanding. prop_prefix must not be
blank because an empty prefix would create ambiguous property names.

An enabled configuration must define the generic sensor fields and four complete noise
dictionaries: position_horizontal_noise, position_vertical_noise, velocity_horizontal_noise, and
velocity_vertical_noise.
-->
<robot name="set_props_plugin_navsat_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="set_props_plugin_navsat"
               params="prop_prefix
                       navsat_sim_cfg:=${dict()}">
    <!-- Reject the prefix before using it to construct properties in the caller's scope. -->
    <xacro:if value="${prop_prefix.strip() == ''}">
      ${xacro.fatal("set_props_plugin_navsat: prop_prefix must not be blank")}
    </xacro:if>

    <!--
    A missing or false enabled field disables simulation.
    The macro still exports every expected property so the higher-level GNSS macro can reference one
    stable interface without checking whether each property exists.
    Zero-valued Gaussian noise keeps the disabled defaults complete.
    -->
    <xacro:unless value="${navsat_sim_cfg.get('enabled', False)}">
      <xacro:property name="${prop_prefix}_enabled"     value="False" scope="parent"/>
      <xacro:property name="${prop_prefix}_use_gravity" value="False" scope="parent"/>
      <xacro:property name="${prop_prefix}_always_on"   value="False" scope="parent"/>
      <xacro:property name="${prop_prefix}_update_rate" value="0"     scope="parent"/>

      <xacro:property name="${prop_prefix}_position_horizontal_noise"
                      value="gaussian 0 0 0 0 0 0 0" scope="parent"/>

      <xacro:property name="${prop_prefix}_position_vertical_noise"
                      value="gaussian 0 0 0 0 0 0 0" scope="parent"/>

      <xacro:property name="${prop_prefix}_velocity_horizontal_noise"
                      value="gaussian 0 0 0 0 0 0 0" scope="parent"/>

      <xacro:property name="${prop_prefix}_velocity_vertical_noise"
                      value="gaussian 0 0 0 0 0 0 0" scope="parent"/>

      <xacro:property name="${prop_prefix}_topic" value="" scope="parent"/>
    </xacro:unless>

    <!-- Validate and export the user configuration only when NavSat simulation is enabled. -->
    <xacro:if value="${navsat_sim_cfg.get('enabled', False)}">
      <!--
      First verify the top-level dictionary.
      This produces one error containing every missing key instead of failing later with a Python
      KeyError while individual values are being read.
      -->
      <xacro:property name="required_fields"
                      value="${['use_gravity',
                                'always_on',
                                'update_rate',
                                'position_horizontal_noise',
                                'position_vertical_noise',
                                'velocity_horizontal_noise',
                                'velocity_vertical_noise',
                                'topic']}"/>

      <xacro:property name="missing_fields"
                      value="${[field for field in required_fields if field not in navsat_sim_cfg]}"/>

      <xacro:if value="${len(missing_fields) != 0}">
        ${xacro.fatal('set_props_plugin_navsat: enabled configuration is missing fields: ' +
                      ', '.join(missing_fields))}
      </xacro:if>

      <!--
      noise_fields is both the required schema for each noise dictionary and the canonical order
      expected by plugin_navsat.
      Keeping one ordered list prevents validation and serialization from drifting apart.
      -->
      <xacro:property name="noise_fields"
                      value="${['type',
                                'mean',
                                'stddev',
                                'bias_mean',
                                'bias_stddev',
                                'dynamic_bias_stddev',
                                'dynamic_bias_correlation_time',
                                'precision']}"/>

      <xacro:property name="noise_config_keys"
                      value="${['position_horizontal_noise',
                                'position_vertical_noise',
                                'velocity_horizontal_noise',
                                'velocity_vertical_noise']}"/>

      <!--
      Check all four noise dictionaries before reading their values.
      The inner Python list comprehension gathers the fields absent from one dictionary.
      The outer comprehension keeps that dictionary's key only when its missing-field list is not
      empty.
      The result therefore contains names such as position_horizontal_noise, not the individual
      missing field names.
      Reporting the dictionary names tells the user exactly which YAML sections need correction.
      -->
      <xacro:property name="incomplete_noise_keys"
                      value="${[key for key in noise_config_keys
                                if len([field for field in noise_fields
                                        if field not in navsat_sim_cfg[key]]) != 0]}"/>

      <xacro:if value="${len(incomplete_noise_keys) != 0}">
        ${xacro.fatal('set_props_plugin_navsat: incomplete noise fields in: ' +
                      ', '.join(incomplete_noise_keys))}
      </xacro:if>

      <!-- Export the validated generic sensor values using the prefix chosen by the caller. -->
      <xacro:property name="${prop_prefix}_enabled" value="True" scope="parent"/>

      <xacro:property name="${prop_prefix}_use_gravity"
                      value="${navsat_sim_cfg['use_gravity']}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_always_on"
                      value="${navsat_sim_cfg['always_on']}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_update_rate"
                      value="${navsat_sim_cfg['update_rate']}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_topic"
                      value="${navsat_sim_cfg['topic']}"
                      scope="parent"/>

      <!--
      YAML represents each noise model as a dictionary because named fields are easy to read and
      review.
      plugin_navsat accepts one space-separated string per model.
      Each pair below reads a dictionary and then serializes its values in the canonical
      noise_fields order.
      -->
      <xacro:property name="position_horizontal_noise"
                      value="${navsat_sim_cfg['position_horizontal_noise']}"/>

      <xacro:property name="${prop_prefix}_position_horizontal_noise"
                      value="${' '.join([str(position_horizontal_noise[field]) for field in noise_fields])}"
                      scope="parent"/>

      <xacro:property name="position_vertical_noise"
                      value="${navsat_sim_cfg['position_vertical_noise']}"/>

      <xacro:property name="${prop_prefix}_position_vertical_noise"
                      value="${' '.join([str(position_vertical_noise[field]) for field in noise_fields])}"
                      scope="parent"/>

      <xacro:property name="velocity_horizontal_noise"
                      value="${navsat_sim_cfg['velocity_horizontal_noise']}"/>

      <xacro:property name="${prop_prefix}_velocity_horizontal_noise"
                      value="${' '.join([str(velocity_horizontal_noise[field]) for field in noise_fields])}"
                      scope="parent"/>

      <xacro:property name="velocity_vertical_noise"
                      value="${navsat_sim_cfg['velocity_vertical_noise']}"/>

      <xacro:property name="${prop_prefix}_velocity_vertical_noise"
                      value="${' '.join([str(velocity_vertical_noise[field]) for field in noise_fields])}"
                      scope="parent"/>
    </xacro:if>
  </xacro:macro>
</robot>
