<?xml version="1.0"?>
<robot name="plugin_camera_logical_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
  Wrapper for a Gazebo `logical_camera` sensor.

  A logical camera does not render pixels.
  Instead, it reports which models are visible inside its frustum and where they are.

  The parameter `topic` is the Gazebo transport topic used for detections.
  The frustum is defined by:
  - `hor_fov_deg`
  - `clip`
  - `aspect_ratio`

  This macro can be used with SDFormat 1.9 and later.

  SDFormat reference:
  http://sdformat.org/spec?ver=1.11&elem=sensor#sensor_camera
  SDFormat 1.11 is parsed by `libsdformat14`, available since Gazebo Harmonic.

  Convention for parameter types:
  - `R`: real number (`float` or `double`)
  - `I`: integer
  - `S`: string
  - `B`: boolean

  Parameters:
  `name (S)`: unique name of the camera.

  `reference_frame (S)`: frame where the Gazebo sensor is attached.

  `optical_frame (S)`: frame id used in the published messages.

  `use_gravity (B)`: if `true`, the camera is affected by gravity.

  `always_on (B)`: if `true`, the sensor updates continuously according to `update_rate`.

  `enable_metrics (B)`: if `true`, the sensor publishes performance metrics.

  `update_rate (R)`: sensor update frequency. If omitted, the sensor updates every cycle.

  `hor_fov_deg (R)`: horizontal field of view in degrees.

  `clip (S)`: near and far distances of the logical camera frustum.
    Format: `clip = 'near (R) far (R)'`
    - `near (R)`: near clipping distance of the view frustum
    - `far (R)`: far clipping distance of the view frustum

  `aspect_ratio (R)`: width/height ratio of the logical camera frustum. This is dimensionless.

  `namespace (S)`: namespace used to resolve relative Gazebo topics configured for the simulated
    streams. If a topic already starts with `/`, it is kept as an absolute topic.

  `topic (S)`: Gazebo transport topic where logical camera detections are published. This field
    is required. If it starts with `/`, it is treated as absolute. Otherwise, it is resolved
    inside the robot namespace.
  -->
  <xacro:macro name="plugin_camera_logical"
               params="name
                       reference_frame
                       optical_frame
                       use_gravity:=True
                       always_on:=True
                       enable_metrics:=False
                       update_rate:=30.0
                       hor_fov_deg:=60.0
                       clip:='0.0 1.0'
                       aspect_ratio:=1.0
                       namespace:=''
                       topic" >

    <xacro:include filename="$(find robotics_description)/urdf/common/resolve_topic_macro.xacro"/>

    <xacro:property name="clip_seq"                 value="${clip.split()}"/>

    <xacro:if value="${len(clip_seq) != 2}">
      ${xacro.fatal("Invalid clip parameter format. Expected format: 'near (R) far (R)'")}
    </xacro:if>

    <xacro:property name="near_clip"                value="${clip_seq[0]}"/>
    <xacro:property name="far_clip"                 value="${clip_seq[1]}"/>

    <xacro:resolve_topic prop_id="resolved_topic"
                         topic="${topic}"
                         namespace="${namespace}"/>

    <gazebo reference="${reference_frame}">
      <gravity>${use_gravity}</gravity>
      <sensor type="logical_camera" name="${name}_gz_sensor">
        <always_on>${always_on}</always_on>
        <enable_metrics>${enable_metrics}</enable_metrics>
        <update_rate>${update_rate}</update_rate>
        <topic>${resolved_topic}</topic>

        <!--
        If the label <gz_frame_id> is not set, Gazebo will use as the 'frame_id' for the message the string
        '<model>::<parent_frame>::${reference_frame}', which is probably what you do not want.
        -->
        <gz_frame_id>${optical_frame}</gz_frame_id>

        <logical_camera>
          <near_clip>${near_clip}</near_clip>
          <far_clip>${far_clip}</far_clip>
          <horizontal_fov>${radians(float(hor_fov_deg))}</horizontal_fov>
          <aspect_ratio>${aspect_ratio}</aspect_ratio>
        </logical_camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
