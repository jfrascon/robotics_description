<?xml version="1.0"?>
<robot name="plugin_lidar_2d_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
  Wrapper for a Gazebo 2D lidar built on top of the generic 3D ring lidar macro.

  This macro keeps the 2D-facing interface, but internally delegates to
  `plugin_lidar_3d_ring` with a collapsed vertical scan:
  - `ver_fov_deg='0 0'`
  - `ver_res_deg='1.0'`

  That produces exactly one vertical sample, which is the 2D lidar case.
  -->
  <xacro:macro name="plugin_lidar_2d"
               params="sensor_name
                       reference_link
                       always_on:=True
                       visualize:=False
                       update_rate
                       hor_fov_deg
                       hor_res_deg
                       dist_span
                       dist_res:=0.0
                       gaussian_noise:='0 0'
                       namespace:=''
                       topic">
    <xacro:include filename="$(find robotics_description)/urdf/sensors/lidars/generic_macros/plugin_lidar_3d_ring_macro.xacro"/>

    <xacro:plugin_lidar_3d_ring sensor_name="${sensor_name}"
                                reference_link="${reference_link}"
                                always_on="${always_on}"
                                visualize="${visualize}"
                                update_rate="${update_rate}"
                                hor_fov_deg="${hor_fov_deg}"
                                hor_res_deg="${hor_res_deg}"
                                ver_fov_deg="0 0"
                                ver_res_deg="1.0"
                                dist_span="${dist_span}"
                                dist_res="${dist_res}"
                                gaussian_noise="${gaussian_noise}"
                                namespace="${namespace}"
                                base_topic="${topic}"/>
  </xacro:macro>
</robot>
