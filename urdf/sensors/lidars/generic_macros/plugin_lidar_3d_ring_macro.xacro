<?xml version="1.0"?>
<!--
The lidar_3d_ring_plugin macro defines a simulated 3D LIDAR sensor using the GPU-accelerated LIDAR simulation in Gazebo.

This macro does not create new links or joints. Instead, it attaches a sensor to an existing link, defined by
'reference_link'.

Visualization in Gazebo can be toggled via 'visualize', and the sensor update rate is
configurable with 'update_rate' (in Hz).

The angular scanning configuration is defined in degrees:
  - Horizontal field of view: from 'hor_min_angle_deg' to 'hor_max_angle_deg', with 'hor_samples' samples.
    The horizontal samples are calculated as:
    hor_samples = ((hor_max_angle_deg - hor_min_angle_deg)/resolution) + 1
                = ((180 - -180)/0.2) + 1 = (360/0.2) + 1 = 1801
  - Vertical field of view: from 'ver_min_angle_deg' to 'ver_max_angle_deg', with 'ver_samples' samples.
    The vertical samples (rings) are calculated as:
    ver_samples (or rings) = ((ver_max_angle - ver_min_angle)/resolution) + 1 = ((15.0 - -15.0)/2.0) + 1 =
                           = (30.0/2.0) + 1 = 15 + 1 = 16

why +1?
Let's condider an example to explain the rationale behind the +1 when computing the number of samples.
Let's consider hor_min_angle_deg = -60, hor_max_angle_deg = 60, and hor_res_deg = 40
without the +1 => hor_samples = ((60 - -60)/40) = (120/40) = 3 => 3 angular sectors, 3 samples, sure that's ok?
I think I should use 4 samples, at -60 deg, -20 deg, 20 deg, and 60 deg, which is 'resul_division + 1'.
Why the int casting?
Let's consider the same example, but with hor_res_deg = 50, and without the int casting
hor_samples = (60 - -60)/50 + 1 = (120/50) = 2.4 + 1 => 3.4 => 3 complete samples.
Samples at -60 deg, -10 deg, 40 deg, and the sample at 90 deg is not included, since it is beyond 60 deg.
So, 3 samples, which is the result of int((60 - -60)/50) + 1 = int(2.4) + 1 = 2 + 1 = 3

The minimum and maximum measurable distances are set via 'dist_span', in meters. These values constrain the
range filter applied to the raw data, simulating the physical limits of typical LIDAR sensors.

Can't use the keyword 'range', instead of 'dist_span', since 'range' it is a reserved keyword in Python, and when using
'${range.split()}'' it raises a warning saying 'redefining global symbol: range'.

The macro supports noise modeling through additive Gaussian noise:
gaussian_noise = 'mean stddev'

TO USE LIDAR PLUGIN DO NOT FORGET TO ADD THE FOLLOWING BLOCK TO THE SDF WORLD FILE YOU USE FOR SIMULATION:

<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
</plugin>

Reference: https://gazebosim.org/docs/harmonic/sensors/

Mandatory parameters:
- sensor_name has 1 value.
- reference_link has 1 value.
- base_topic has 1 value.
- update_rate has 1 value.
- hor_fov_deg has 2 values between quotes in this order, 'min_hor_angle_deg max_hor_angle_deg'
- hor_res_deg has 1 value.
- ver_fov_deg has 2 values between quotes in this order 'min_ver_angle_deg max_ver_angle_deg'
- ver_res_deg has 1 value.
- dist_span has 2 values between quotes in this order 'min_dist max_dist'
- dist_res has 1 value, in meters.
-->
<robot name="plugin_lidar_3d_ring_macro" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:macro name="plugin_lidar_3d_ring"
               params="sensor_name
                       reference_link
                       always_on:=True
                       visualize:=False
                       update_rate
                       hor_fov_deg
                       hor_res_deg
                       ver_fov_deg
                       ver_res_deg
                       dist_span
                       dist_res:=0.0
                       gaussian_noise:='0 0'
                       namespace:=''
                       base_topic">

    <xacro:include filename="$(find robotics_description)/urdf/common/resolve_topic_macro.xacro"/>

    <!--
    According to the documentation at 'http://sdformat.org/spec?ver=1.7&elem=sensor#sensor_ray'
    The 'gpu_ray' type is equivalent to the 'gpu_lidar' type.
    It is preferred to use the 'gpu_lidar' type since 'gpu_ray' type will be deprecated at some point.
    The 'gpu_ray' type is maintained for legacy support.
    -->

    <xacro:property name="hor_min_max_angles_deg" value="${hor_fov_deg.split()}"/>
    <xacro:property name="hor_min_angle_deg"      value="${hor_min_max_angles_deg[0]}"/>
    <xacro:property name="hor_max_angle_deg"      value="${hor_min_max_angles_deg[1]}"/>
    <xacro:property name="hor_span_deg"           value="${float(hor_max_angle_deg) - float(hor_min_angle_deg)}"/>
    <xacro:property name="hor_samples"            value="${int(hor_span_deg / hor_res_deg) + 1}"/>

    <xacro:property name="ver_min_max_angles_deg" value="${ver_fov_deg.split()}"/>
    <xacro:property name="ver_min_angle_deg"      value="${ver_min_max_angles_deg[0]}"/>
    <xacro:property name="ver_max_angle_deg"      value="${ver_min_max_angles_deg[1]}"/>
    <xacro:property name="ver_span_deg"           value="${float(ver_max_angle_deg) - float(ver_min_angle_deg)}"/>
    <xacro:property name="ver_samples"            value="${int(ver_span_deg / ver_res_deg) + 1}"/>

    <xacro:property name="min_max_dists"          value="${dist_span.split()}"/>
    <xacro:property name="min_dist"               value="${min_max_dists[0]}"/>
    <xacro:property name="max_dist"               value="${min_max_dists[1]}"/>

    <xacro:property name="gaussian_noise_seq"     value="${gaussian_noise.split()}"/>
    <xacro:property name="gaussian_noise_mean"    value="${gaussian_noise_seq[0]}"/>
    <xacro:property name="gaussian_noise_stddev"  value="${gaussian_noise_seq[1]}"/>

    <!--
    GZ plugin `gpu_lidar` publish two topics in this plugin:
    - '${topic_given_to_gpu_lidar_plugin}' with type `gz.msgs.LaserScan`
    (definition at https://github.com/gazebosim/gz-msgs/blob/gz-msgs12/proto/gz/msgs/laserscan.proto)
    that represents a 3D scan. However, according to the table at
    https://github.com/gazebosim/ros_gz/tree/ros2/ros_gz_bridge#bridge-communication-between-ros-and-gazebo
    this GZ message type maps to the ROS message types `sensor_msgs/msg/LaserScan`, used to
    represent a 2D scan and `sensor_msgs/msg/Range`, to represent a single range measurement
    sensor, like a proximity sensor (IR or sonar).
    - '${topic_given_to_gpu_lidar_plugin}/points' with type `gz.msgs.PointCloudPacked`
    (definition at https://github.com/gazebosim/gz-msgs/blob/gz-msgs12/proto/gz/msgs/pointcloud_packed.proto)
    that represents a 3D point cloud. According to the table at
    https://github.com/gazebosim/ros_gz/tree/ros2/ros_gz_bridge#bridge-communication-between-ros-and-gazebo
    this GZ message type maps to the ROS message type `sensor_msgs/msg/PointCloud2`, used to represent a 3D point cloud.
    -->

    <xacro:resolve_topic prop_id="resolved_base_topic"
                         topic="${base_topic}"
                         namespace="${namespace}"/>

    <gazebo reference="${reference_link}">
      <gravity>True</gravity>
      <sensor type="gpu_lidar" name="${sensor_name}">
        <always_on>${always_on}</always_on>
        <visualize>${visualize}</visualize>
        <update_rate>${update_rate}</update_rate>

        <topic>${resolved_base_topic}</topic>
        <!--
        If the label <gz_frame_id> is not set, Gazebo will use as the 'frame_id' for the message, the string
        '<model>::${parent_frame}::${laser_id}_link', which probably is not what you want.
        -->
        <gz_frame_id>${reference_link}</gz_frame_id>
        <enable_metrics>False</enable_metrics>
        <lidar>
          <scan>
            <horizontal>
              <min_angle>${radians(float(hor_min_angle_deg))}</min_angle>
              <max_angle>${radians(float(hor_max_angle_deg))}</max_angle>
              <samples>${hor_samples}</samples>
              <!-- DO NOT TOUCH IT, LEAVE IT TO 1.0 -->
              <resolution>1.0</resolution>
            </horizontal>
            <vertical>
              <min_angle>${radians(float(ver_min_angle_deg))}</min_angle>
              <max_angle>${radians(float(ver_max_angle_deg))}</max_angle>
              <samples>${ver_samples}</samples>
              <!-- DO NOT TOUCH, LEAVE IT TO 1.0 -->
              <resolution>1.0</resolution>
            </vertical>
          </scan>
          <range>
            <min>${min_dist}</min>
            <max>${max_dist}</max>
            <resolution>${dist_res}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>${gaussian_noise_mean}</mean>
            <stddev>${gaussian_noise_stddev}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
