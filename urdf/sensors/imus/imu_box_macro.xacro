<?xml version="1.0"?>
<!--
Generic rectangular IMU macro.

This macro defines an IMU with a nominal rectangular envelope given by size.
All three size values must be greater than zero. When inertial data is enabled,
mass must also be greater than zero, and mass and size define a solid-box
inertia; using a visual or collision mesh does not change the inertial model.
When inertial data is disabled, mass is ignored and a small null inertia is
inserted to keep the root link valid.

Visual and collision geometry are selected independently:
- If use_visual is false, no visual element is created.
- If use_visual is true, an empty v_mesh selects a box primitive and a non-empty
  v_mesh selects the visual mesh.
- If use_collision is false, no collision element is created.
- If use_collision is true, an empty c_mesh selects a box primitive and a
  non-empty c_mesh selects the collision mesh.

This permits any combination of mesh and primitive representations. A mesh path
must be package-relative and include the package name. v_mesh_scale and
c_mesh_scale apply only to their corresponding meshes.

If sim_enabled is false, no Gazebo IMU sensor is created. If it is true,
sim_topic must not be blank.

The root-link frame is at the center of the lower face of the nominal IMU box.
body_origin shifts the visual, collision and inertial elements upward by half the box height.
A URDF box primitive is centered on its coordinate frame and its dimensions follow X, Y and Z.
A supplied mesh is therefore expected to have its coordinate frame at its geometric center.
Its scaled bounds and axis orientation should represent the same nominal envelope as size.
When those conditions are met, the mesh and box primitive can use the same body_origin.
The mesh may contain non-box details, but size still controls the box fallback and inertia.
The macro does not verify that a mesh exists or infer or validate its dimensions.

${prefix}${name}_root_link contains the body geometry and inertia.
joint_parent_fr_root_fr places that body frame relative to parent_frame.
${prefix}${name}_link is the sensor data frame, and joint_root_fr_data_fr places
it relative to the body frame. The Gazebo IMU sensor is attached to this data
frame.
-->
<robot name="imu_box_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotics_description)/urdf/common/all_commons.xacro"/>
  <xacro:include filename="$(find robotics_description)/urdf/sensors/imus/generic_macros/plugin_imu_macro.xacro"/>

  <xacro:macro name="imu_box"
               params="name
                       prefix:=''
                       parent_frame
                       mass
                       size
                       use_visual:=True
                       use_collision:=True
                       use_inertial:=True
                       v_mesh:=''
                       v_mesh_scale:='1.0 1.0 1.0'
                       color:=''
                       c_mesh:=''
                       c_mesh_scale:='1.0 1.0 1.0'
                       joint_parent_fr_root_fr
                       joint_root_fr_data_fr:='0 0 0 0 0 0'
                       sim_enabled:=False
                       sim_use_gravity:=True
                       sim_always_on:=True
                       sim_update_rate:=100
                       sim_ang_vel_gaussian_noise:='0 0 0 0 0 0'
                       sim_ang_vel_gaussian_noise_bias:='0 0 0 0 0 0'
                       sim_ang_vel_gaussian_noise_dynamic_bias:='0 0 0 0 0 0'
                       sim_lin_acc_gaussian_noise:='0 0 0 0 0 0'
                       sim_lin_acc_gaussian_noise_bias:='0 0 0 0 0 0'
                       sim_lin_acc_gaussian_noise_dynamic_bias:='0 0 0 0 0 0'
                       sim_use_orientation:=True
                       namespace:=''
                       sim_topic:=''">

    <xacro:property name="size_seq" value="${size.split()}"/>

    <xacro:if value="${len(size_seq) != 3}">
      ${xacro.fatal("imu_box: size must be 'len_x len_y len_z'")}
    </xacro:if>

    <xacro:if value="${float(size_seq[0]) &lt;= 0.0 or
                       float(size_seq[1]) &lt;= 0.0 or
                       float(size_seq[2]) &lt;= 0.0}">
      ${xacro.fatal("imu_box: size values must be greater than zero")}
    </xacro:if>

    <!--
    The root link frame is located at the center of the lower face of the IMU box.
    -->
    <xacro:property name="body_origin"
                    value="0 0 ${0.5 * float(size_seq[2])} 0 0 0"/>

    <link name="${prefix}${name}_root_link">
      <xacro:if value="${use_visual}">
        <xacro:property name="v_color"
                        value="${(prefix + name + '_color ' + color) if color != '' else ''}"/>

        <xacro:if value="${v_mesh != ''}">
          <xacro:visual_mesh mesh="${v_mesh}"
                             scale="${v_mesh_scale}"
                             mesh_origin="${body_origin}"
                             color="${v_color}"/>
        </xacro:if>

        <xacro:unless value="${v_mesh != ''}">
          <xacro:visual_box size="${size}"
                            shape_origin="${body_origin}"
                            color="${v_color}"/>
        </xacro:unless>
      </xacro:if>

      <xacro:if value="${use_collision}">
        <xacro:if value="${c_mesh != ''}">
          <xacro:collision_mesh mesh="${c_mesh}"
                                scale="${c_mesh_scale}"
                                mesh_origin="${body_origin}"/>
        </xacro:if>

        <xacro:unless value="${c_mesh != ''}">
          <xacro:collision_box size="${size}"
                               shape_origin="${body_origin}"/>
        </xacro:unless>
      </xacro:if>

      <xacro:if value="${use_inertial}">
        <xacro:if value="${float(mass) &lt;= 0.0}">
          ${xacro.fatal("imu_box: mass must be greater than zero when inertial data is enabled")}
        </xacro:if>
        <xacro:solid_box_inertia mass="${mass}" size="${size}" origin="${body_origin}"/>
      </xacro:if>

      <xacro:unless value="${use_inertial}">
        <xacro:null_inertia/>
      </xacro:unless>
    </link>

    <xacro:property name="parent_root_seq" value="${joint_parent_fr_root_fr.split()}"/>

    <xacro:if value="${len(parent_root_seq) != 6}">
      ${xacro.fatal("imu_box: joint_parent_fr_root_fr must be 'x y z roll pitch yaw'")}
    </xacro:if>

    <joint name="${prefix}${name}_root_joint" type="fixed">
      <parent link="${parent_frame}"/>
      <child link="${prefix}${name}_root_link"/>
      <origin rpy="${parent_root_seq[3]} ${parent_root_seq[4]} ${parent_root_seq[5]}"
              xyz="${parent_root_seq[0]} ${parent_root_seq[1]} ${parent_root_seq[2]}"/>
    </joint>

    <link name="${prefix}${name}_link">
      <xacro:null_inertia/>
    </link>

    <xacro:property name="root_data_seq" value="${joint_root_fr_data_fr.split()}"/>

    <xacro:if value="${len(root_data_seq) != 6}">
      ${xacro.fatal("imu_box: joint_root_fr_data_fr must be 'x y z roll pitch yaw'")}
    </xacro:if>

    <joint name="${prefix}${name}_joint" type="fixed">
      <parent link="${prefix}${name}_root_link"/>
      <child link="${prefix}${name}_link"/>
      <origin rpy="${root_data_seq[3]} ${root_data_seq[4]} ${root_data_seq[5]}"
              xyz="${root_data_seq[0]} ${root_data_seq[1]} ${root_data_seq[2]}"/>
    </joint>

    <xacro:if value="${sim_enabled}">
      <xacro:if value="${sim_topic.strip() == ''}">
        ${xacro.fatal("imu_box: sim_topic must not be blank when simulation is enabled")}
      </xacro:if>

      <xacro:if value="${use_visual and color != ''}">
        <gazebo reference="${prefix}${name}_root_link">
          <material>
            <ambient>${color}</ambient>
            <diffuse>${color}</diffuse>
          </material>
        </gazebo>
      </xacro:if>

      <xacro:plugin_imu
        sensor_name="${prefix}${name}_gz"
        reference_link="${prefix}${name}_link"
        use_gravity="${sim_use_gravity}"
        always_on="${sim_always_on}"
        update_rate="${sim_update_rate}"
        ang_vel_gaussian_noise="${sim_ang_vel_gaussian_noise}"
        ang_vel_gaussian_noise_bias="${sim_ang_vel_gaussian_noise_bias}"
        ang_vel_gaussian_noise_dynamic_bias="${sim_ang_vel_gaussian_noise_dynamic_bias}"
        lin_acc_gaussian_noise="${sim_lin_acc_gaussian_noise}"
        lin_acc_gaussian_noise_bias="${sim_lin_acc_gaussian_noise_bias}"
        lin_acc_gaussian_noise_dynamic_bias="${sim_lin_acc_gaussian_noise_dynamic_bias}"
        use_orientation="${sim_use_orientation}"
        namespace="${namespace}"
        topic="${sim_topic}"/>
    </xacro:if>
  </xacro:macro>
</robot>
