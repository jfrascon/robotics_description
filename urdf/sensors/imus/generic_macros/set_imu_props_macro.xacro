<?xml version="1.0"?>
<robot name="set_imu_props" xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:macro name="set_imu_props" params="desc_cfg sim_cfg:=${None} prop_prefix">

    <xacro:property name="${prop_prefix}_mass"   value="${desc_cfg['mass']}"  scope="parent"/>
    <xacro:property name="${prop_prefix}_shape"  value="${desc_cfg['shape']}" scope="parent"/>

    <!--
    desc_cfg['shape'] can have any of these values:
    shape: { "type": "r",  "size": { "x": sx,    "y": sy,    "z": sz } }    => shape='r  sx    sy    sz'
    shape: { "type": "cx", "size": { "x": thick, "y": 2*rad, "z": 2*rad } } => shape='cx thickness 2*radius  2*radius'
    shape: { "type": "cy", "size": { "x": 2*rad, "y": thick, "z": 2*rad } } => shape='cy 2*radius  thickness 2*radius'
    shape: { "type": "cz", "size": { "x": 2*rad, "y": 2*rad, "z": thick } } => shape='cz 2*radius  2*radius  thickness'
    shape: { "type": "s",  "size": { "x": 2*rad, "y": 2*rad, "z": 2*rad } } => shape='s  2*radius  2*radius  2*radius'

    r  => rectangle (box)
    cx => cylinder along x axis
    cy => cylinder along y axis
    cz => cylinder along z axis
    s  => sphere
    -->

    <xacro:property name="${prop_prefix}_size_x"
                    value="${desc_cfg['shape']['size']['x']}"
                    scope="parent"/>

    <xacro:property name="${prop_prefix}_size_y"
                    value="${desc_cfg['shape']['size']['y']}"
                    scope="parent"/>

    <xacro:property name="${prop_prefix}_size_z"
                    value="${desc_cfg['shape']['size']['z']}"
                    scope="parent"/>

      <!--
      If you can accommodate all the values that constitute the string in a single line in the 'value' field, you can do
      it directly as:
      <xacro:property name="${prop_prefix}_size_z"
                      value="${desc_cfg['shape']['size_z']}"
                      scope="parent"/>
      But if you need to split the line that you assign to the 'value' field, because the line is too long to fit in a
      single with a resonable length, then you have to use the 'join' method as done below to avoid sevaral whitespaces
      in the resulting string separating the values when the macro is expanded.
      -->

    <xacro:property name="${prop_prefix}_shape"
                    value="${' '.join([desc_cfg['shape']['type'],
                                        str(desc_cfg['shape']['size']['x']),
                                        str(desc_cfg['shape']['size']['y']),
                                        str(desc_cfg['shape']['size']['z'])])}"
                    scope="parent"/>

    <xacro:property name="_imu_mesh_visual"    value="${desc_cfg.get('mesh_visual', '')}"/>
    <xacro:property name="_imu_mesh_collision" value="${desc_cfg.get('mesh_collision', '')}"/>

    <xacro:if value="${_imu_mesh_visual is not None and _imu_mesh_visual != ''}">
      <xacro:property name="${prop_prefix}_mesh_visual"
                      value="${_imu_mesh_visual}"
                      scope="parent"/>
    </xacro:if>

    <xacro:if value="${_imu_mesh_visual is None or _imu_mesh_visual == ''}">
      <xacro:property name="${prop_prefix}_mesh_visual"
                      value=""
                      scope="parent"/>
    </xacro:if>

    <xacro:property name="${prop_prefix}_mesh_visual_has_color"
                    value="${desc_cfg['mesh_visual_has_color']}"
                    scope="parent"/>

    <xacro:property name="_imu_color"
                    value="${desc_cfg.get('color', dict(r = 0, g = 0, b = 0, a = 1))}"/>

    <xacro:property name="${prop_prefix}_color"
                    value="${_imu_color['r']} ${_imu_color['g']} ${_imu_color['b']} ${_imu_color['a']}"
                    scope="parent"/>

    <xacro:if value="${_imu_mesh_collision is not None and _imu_mesh_collision != ''}">
      <xacro:property name="${prop_prefix}_mesh_collision"
                      value="${_imu_mesh_collision}"
                      scope="parent"/>
    </xacro:if>

    <xacro:if value="${_imu_mesh_collision is None or _imu_mesh_collision == ''}">
      <xacro:property name="${prop_prefix}_mesh_collision"
                      value=""
                      scope="parent"/>
    </xacro:if>

    <xacro:property name="_imu_scale" value="${desc_cfg['scale']}"/>

    <xacro:property name="${prop_prefix}_scale"
                    value="${_imu_scale['x']} ${_imu_scale['y']} ${_imu_scale['z']}"
                    scope="parent"/>

    <xacro:property name="${prop_prefix}_joint_root_fr_data_fr"
                    value="${' '.join([str(desc_cfg['joint_root_fr_data_fr']['x']),
                                       str(desc_cfg['joint_root_fr_data_fr']['y']),
                                       str(desc_cfg['joint_root_fr_data_fr']['z']),
                                       str(desc_cfg['joint_root_fr_data_fr']['R']),
                                       str(desc_cfg['joint_root_fr_data_fr']['P']),
                                       str(desc_cfg['joint_root_fr_data_fr']['Y'])])}"
                    scope="parent"/>

    <!--
    If no sim_cfg is provided, the following properties are created in the parent scope with value 'None':
    '${prop_prefix}_sim_always_on'
    '${prop_prefix}_sim_update_rate'
    '${prop_prefix}_sim_ang_vel_gaussian_noise'
    '${prop_prefix}_sim_ang_vel_gaussian_noise_bias'
    '${prop_prefix}_sim_ang_vel_gaussian_noise_dynamic_bias'
    '${prop_prefix}_sim_lin_acc_gaussian_noise'
    '${prop_prefix}_sim_lin_acc_gaussian_noise_bias'
    '${prop_prefix}_sim_lin_acc_gaussian_noise_dynamic_bias'
    '${prop_prefix}_sim_use_orientation'

    If the sim_cfg is provided, the following fields are required to be present in the sim_cfg dictionary:
    'always_on'
    'update_rate'
    'ang_vel_gaussian_noise':
                { 'mean_x': .., 'stddev_x': .., 'mean_y': .., 'stddev_y': .., 'mean_z': .., 'stddev_z' }
    'ang_vel_gaussian_noise_bias':
                { 'mean_x': .., 'stddev_x': .., 'mean_y': .., 'stddev_y': .., 'mean_z': .., 'stddev_z' }
    'ang_vel_gaussian_noise_dynamic_bias':
                { 'stddev_x': .., 'corr_time_x': .., 'stddev_y': .., 'corr_time_y': .., 'stddev_z': .., 'corr_time_z' }
    'lin_acc_gaussian_noise':
                { 'mean_x': .., 'stddev_x': .., 'mean_y': .., 'stddev_y': .., 'mean_z': .., 'stddev_z' }
    'lin_acc_gaussian_noise_bias':
                { 'mean_x': .., 'stddev_x': .., 'mean_y': .., 'stddev_y': .., 'mean_z': .., 'stddev_z' }
    'lin_acc_gaussian_noise_dynamic_bias':
                { 'stddev_x': .., 'corr_time_x': .., 'stddev_y': .., 'corr_time_y': .., 'stddev_z': .., 'corr_time_z' }
    'use_orientation'
    -->

    <xacro:if value="${sim_cfg is None}">
      <xacro:property name="${prop_prefix}_use_sim"                                 value="False"     scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_always_on"                           value="False"     scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_update_rate"                         value="0.0"       scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_ang_vel_gaussian_noise"              value="${dict()}" scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_ang_vel_gaussian_noise_bias"         value="${dict()}" scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_ang_vel_gaussian_noise_dynamic_bias" value="${dict()}" scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_lin_acc_gaussian_noise"              value="${dict()}" scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_lin_acc_gaussian_noise_bias"         value="${dict()}" scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_lin_acc_gaussian_noise_dynamic_bias" value="${dict()}" scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_use_orientation"                     value="False"     scope="parent"/>
    </xacro:if>

    <xacro:if value="${sim_cfg is not None}">
      <xacro:property name="${prop_prefix}_use_sim"          value="True"                      scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_always_on"    value="${sim_cfg['always_on']}"   scope="parent"/>
      <xacro:property name="${prop_prefix}_sim_update_rate"  value="${sim_cfg['update_rate']}" scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_ang_vel_gaussian_noise"
                      value="${' '.join([str(sim_cfg['ang_vel_gaussian_noise']['mean_x']),
                                         str(sim_cfg['ang_vel_gaussian_noise']['stddev_x']),
                                         str(sim_cfg['ang_vel_gaussian_noise']['mean_y']),
                                         str(sim_cfg['ang_vel_gaussian_noise']['stddev_y']),
                                         str(sim_cfg['ang_vel_gaussian_noise']['mean_z']),
                                         str(sim_cfg['ang_vel_gaussian_noise']['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_ang_vel_gaussian_noise_bias"
                      value="${' '.join([str(sim_cfg['ang_vel_gaussian_noise_bias']['mean_x']),
                                         str(sim_cfg['ang_vel_gaussian_noise_bias']['stddev_x']),
                                         str(sim_cfg['ang_vel_gaussian_noise_bias']['mean_y']),
                                         str(sim_cfg['ang_vel_gaussian_noise_bias']['stddev_y']),
                                         str(sim_cfg['ang_vel_gaussian_noise_bias']['mean_z']),
                                         str(sim_cfg['ang_vel_gaussian_noise_bias']['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_ang_vel_gaussian_noise_dynamic_bias"
                      value="${' '.join([str(sim_cfg['ang_vel_gaussian_noise_dynamic_bias']['stddev_x']),
                                         str(sim_cfg['ang_vel_gaussian_noise_dynamic_bias']['corr_time_x']),
                                         str(sim_cfg['ang_vel_gaussian_noise_dynamic_bias']['stddev_y']),
                                         str(sim_cfg['ang_vel_gaussian_noise_dynamic_bias']['corr_time_y']),
                                         str(sim_cfg['ang_vel_gaussian_noise_dynamic_bias']['stddev_z']),
                                         str(sim_cfg['ang_vel_gaussian_noise_dynamic_bias']['corr_time_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_lin_acc_gaussian_noise"
                      value="${' '.join([str(sim_cfg['lin_acc_gaussian_noise']['mean_x']),
                                         str(sim_cfg['lin_acc_gaussian_noise']['stddev_x']),
                                         str(sim_cfg['lin_acc_gaussian_noise']['mean_y']),
                                         str(sim_cfg['lin_acc_gaussian_noise']['stddev_y']),
                                         str(sim_cfg['lin_acc_gaussian_noise']['mean_z']),
                                         str(sim_cfg['lin_acc_gaussian_noise']['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_lin_acc_gaussian_noise_bias"
                      value="${' '.join([str(sim_cfg['lin_acc_gaussian_noise_bias']['mean_x']),
                                         str(sim_cfg['lin_acc_gaussian_noise_bias']['stddev_x']),
                                         str(sim_cfg['lin_acc_gaussian_noise_bias']['mean_y']),
                                         str(sim_cfg['lin_acc_gaussian_noise_bias']['stddev_y']),
                                         str(sim_cfg['lin_acc_gaussian_noise_bias']['mean_z']),
                                         str(sim_cfg['lin_acc_gaussian_noise_bias']['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_lin_acc_gaussian_noise_dynamic_bias"
                      value="${' '.join([str(sim_cfg['lin_acc_gaussian_noise_dynamic_bias']['stddev_x']),
                                         str(sim_cfg['lin_acc_gaussian_noise_dynamic_bias']['corr_time_x']),
                                         str(sim_cfg['lin_acc_gaussian_noise_dynamic_bias']['stddev_y']),
                                         str(sim_cfg['lin_acc_gaussian_noise_dynamic_bias']['corr_time_y']),
                                         str(sim_cfg['lin_acc_gaussian_noise_dynamic_bias']['stddev_z']),
                                         str(sim_cfg['lin_acc_gaussian_noise_dynamic_bias']['corr_time_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_sim_use_orientation" value="${sim_cfg['use_orientation']}" scope="parent"/>
    </xacro:if>
  </xacro:macro>
</robot>
