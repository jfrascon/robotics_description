<?xml version="1.0"?>
<!--
IMU simulation configuration adapter.

The macro converts an optional configuration dictionary into flat Xacro
properties in the caller scope. prop_prefix must not be blank.

If enabled is absent or false, all generated properties disable simulation and
the remaining configuration fields are ignored. If enabled is true, the
configuration must provide every field consumed by plugin_imu.

Gaussian noise and bias dictionaries use mean_<axis> and stddev_<axis>.
Dynamic-bias dictionaries use stddev_<axis> and corr_time_<axis>.
-->
<robot name="set_props_plugin_imu_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="set_props_plugin_imu"
               params="prop_prefix
                       imu_sim_cfg:=${dict()}">

    <xacro:if value="${prop_prefix.strip() == ''}">
      ${xacro.fatal("set_props_plugin_imu: prop_prefix must not be blank")}
    </xacro:if>

    <!--
    If imu_sim_cfg does not have the field 'enabled' or if it is set to False, then set all the simulation
    properties to disable the simulation of the imu.
    -->
    <xacro:unless value="${imu_sim_cfg.get('enabled', False)}">
      <xacro:property name="${prop_prefix}_enabled"
                      value="False"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_use_gravity"
                      value="False"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_always_on"
                      value="False"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_update_rate"
                      value="0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_ang_vel_gaussian_noise"
                      value="0 0 0 0 0 0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_ang_vel_gaussian_noise_bias"
                      value="0 0 0 0 0 0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_ang_vel_gaussian_noise_dynamic_bias"
                      value="0 0 0 0 0 0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_lin_acc_gaussian_noise"
                      value="0 0 0 0 0 0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_lin_acc_gaussian_noise_bias"
                      value="0 0 0 0 0 0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_lin_acc_gaussian_noise_dynamic_bias"
                      value="0 0 0 0 0 0"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_use_orientation"
                      value="False"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_topic"
                      value=""
                      scope="parent"/>
    </xacro:unless>

    <!--
    If imu_sim_cfg has the field 'enabled' set to True, then set all the simulation properties according to the
    values in imu_sim_cfg. The configuration is expected to be complete.
    -->
    <xacro:if value="${imu_sim_cfg.get('enabled', False)}">
      <xacro:property name="required_fields"
                      value="${['use_gravity',
                                'always_on',
                                'update_rate',
                                'ang_vel_gaussian_noise',
                                'ang_vel_gaussian_noise_bias',
                                'ang_vel_gaussian_noise_dynamic_bias',
                                'lin_acc_gaussian_noise',
                                'lin_acc_gaussian_noise_bias',
                                'lin_acc_gaussian_noise_dynamic_bias',
                                'use_orientation',
                                'topic']}"/>
      <xacro:property name="missing_fields"
                      value="${[field for field in required_fields if field not in imu_sim_cfg]}"/>

      <xacro:if value="${len(missing_fields) != 0}">
        ${xacro.fatal('set_props_plugin_imu: enabled configuration is missing fields: ' +
                      ', '.join(missing_fields))}
      </xacro:if>

      <xacro:property name="${prop_prefix}_enabled"
                      value="True"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_use_gravity"
                      value="${imu_sim_cfg['use_gravity']}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_always_on"
                      value="${imu_sim_cfg['always_on']}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_update_rate"
                      value="${imu_sim_cfg['update_rate']}"
                      scope="parent"/>

      <xacro:property name="sim_ang_vel_gaussian_noise"
                      value="${imu_sim_cfg['ang_vel_gaussian_noise']}"/>
      <xacro:property name="${prop_prefix}_ang_vel_gaussian_noise"
                      value="${' '.join([str(sim_ang_vel_gaussian_noise['mean_x']),
                                         str(sim_ang_vel_gaussian_noise['stddev_x']),
                                         str(sim_ang_vel_gaussian_noise['mean_y']),
                                         str(sim_ang_vel_gaussian_noise['stddev_y']),
                                         str(sim_ang_vel_gaussian_noise['mean_z']),
                                         str(sim_ang_vel_gaussian_noise['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="sim_ang_vel_gaussian_noise_bias"
                      value="${imu_sim_cfg['ang_vel_gaussian_noise_bias']}"/>
      <xacro:property name="${prop_prefix}_ang_vel_gaussian_noise_bias"
                      value="${' '.join([str(sim_ang_vel_gaussian_noise_bias['mean_x']),
                                         str(sim_ang_vel_gaussian_noise_bias['stddev_x']),
                                         str(sim_ang_vel_gaussian_noise_bias['mean_y']),
                                         str(sim_ang_vel_gaussian_noise_bias['stddev_y']),
                                         str(sim_ang_vel_gaussian_noise_bias['mean_z']),
                                         str(sim_ang_vel_gaussian_noise_bias['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="sim_ang_vel_gaussian_noise_dynamic_bias"
                      value="${imu_sim_cfg['ang_vel_gaussian_noise_dynamic_bias']}"/>
      <xacro:property name="${prop_prefix}_ang_vel_gaussian_noise_dynamic_bias"
                      value="${' '.join([str(sim_ang_vel_gaussian_noise_dynamic_bias['stddev_x']),
                                         str(sim_ang_vel_gaussian_noise_dynamic_bias['corr_time_x']),
                                         str(sim_ang_vel_gaussian_noise_dynamic_bias['stddev_y']),
                                         str(sim_ang_vel_gaussian_noise_dynamic_bias['corr_time_y']),
                                         str(sim_ang_vel_gaussian_noise_dynamic_bias['stddev_z']),
                                         str(sim_ang_vel_gaussian_noise_dynamic_bias['corr_time_z'])])}"
                      scope="parent"/>

      <xacro:property name="sim_lin_acc_gaussian_noise"
                      value="${imu_sim_cfg['lin_acc_gaussian_noise']}"/>
      <xacro:property name="${prop_prefix}_lin_acc_gaussian_noise"
                      value="${' '.join([str(sim_lin_acc_gaussian_noise['mean_x']),
                                         str(sim_lin_acc_gaussian_noise['stddev_x']),
                                         str(sim_lin_acc_gaussian_noise['mean_y']),
                                         str(sim_lin_acc_gaussian_noise['stddev_y']),
                                         str(sim_lin_acc_gaussian_noise['mean_z']),
                                         str(sim_lin_acc_gaussian_noise['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="sim_lin_acc_gaussian_noise_bias"
                      value="${imu_sim_cfg['lin_acc_gaussian_noise_bias']}"/>
      <xacro:property name="${prop_prefix}_lin_acc_gaussian_noise_bias"
                      value="${' '.join([str(sim_lin_acc_gaussian_noise_bias['mean_x']),
                                         str(sim_lin_acc_gaussian_noise_bias['stddev_x']),
                                         str(sim_lin_acc_gaussian_noise_bias['mean_y']),
                                         str(sim_lin_acc_gaussian_noise_bias['stddev_y']),
                                         str(sim_lin_acc_gaussian_noise_bias['mean_z']),
                                         str(sim_lin_acc_gaussian_noise_bias['stddev_z'])])}"
                      scope="parent"/>

      <xacro:property name="sim_lin_acc_gaussian_noise_dynamic_bias"
                      value="${imu_sim_cfg['lin_acc_gaussian_noise_dynamic_bias']}"/>
      <xacro:property name="${prop_prefix}_lin_acc_gaussian_noise_dynamic_bias"
                      value="${' '.join([str(sim_lin_acc_gaussian_noise_dynamic_bias['stddev_x']),
                                         str(sim_lin_acc_gaussian_noise_dynamic_bias['corr_time_x']),
                                         str(sim_lin_acc_gaussian_noise_dynamic_bias['stddev_y']),
                                         str(sim_lin_acc_gaussian_noise_dynamic_bias['corr_time_y']),
                                         str(sim_lin_acc_gaussian_noise_dynamic_bias['stddev_z']),
                                         str(sim_lin_acc_gaussian_noise_dynamic_bias['corr_time_z'])])}"
                      scope="parent"/>

      <xacro:property name="${prop_prefix}_use_orientation"
                      value="${imu_sim_cfg['use_orientation']}"
                      scope="parent"/>
      <xacro:property name="${prop_prefix}_topic"
                      value="${imu_sim_cfg['topic']}"
                      scope="parent"/>
    </xacro:if>
  </xacro:macro>
</robot>
